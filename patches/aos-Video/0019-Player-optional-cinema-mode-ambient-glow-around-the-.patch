+// limitations under the License.
+
+package com.archos.mediacenter.video.player;
+
+import android.content.SharedPreferences;
+import android.graphics.Bitmap;
+import android.graphics.RenderEffect;
+import android.graphics.Shader;
+import android.graphics.drawable.BitmapDrawable;
+import android.graphics.drawable.ColorDrawable;
+import android.graphics.drawable.Drawable;
+import android.graphics.drawable.TransitionDrawable;
+import android.os.Build;
+import android.os.Handler;
+import android.os.HandlerThread;
+import android.os.Looper;
+import android.view.PixelCopy;
+import android.view.SurfaceView;
+import android.view.TextureView;
+import android.view.View;
+import android.widget.ImageView;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+/**
+ * Optional "cinema mode" (YouTube's ambient mode): the bars around the picture glow with the
+ * colors of the video instead of being black.
+ *
+ * A tiny copy of the current frame is taken about once a second, blurred and stretched behind the
+ * video, then cross-faded so the glow follows the scene softly. Only pixels already on screen are
+ * read; nothing is stored.
+ */
+public final class AmbientModeController {
+
+    private static final Logger log = LoggerFactory.getLogger(AmbientModeController.class);
+
+    public static final String KEY_AMBIENT_MODE = "player_ambient_mode";
+
+    private static final long CAPTURE_INTERVAL_MS = 700;
+    private static final int CROSSFADE_MS = 650;
+    private static final int SAMPLE_WIDTH = 32;
+    private static final float GLOW_ALPHA = 0.55f;
+
+    private final ImageView mGlowView;
+    private final SurfaceController mSurfaceController;
+    private final Handler mMainHandler = new Handler(Looper.getMainLooper());
+    private HandlerThread mCopyThread;
+    private Handler mCopyHandler;
+    private boolean mRunning;
+    private boolean mCopyPending;
+    private Drawable mCurrent;
+
+    public AmbientModeController(ImageView glowView, SurfaceController surfaceController) {
+        mGlowView = glowView;
+        mSurfaceController = surfaceController;
+        mGlowView.setScaleType(ImageView.ScaleType.FIT_XY);
+        mGlowView.setAlpha(GLOW_ALPHA);
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+            mGlowView.setRenderEffect(RenderEffect.createBlurEffect(48f, 48f, Shader.TileMode.CLAMP));
+        }
+    }
+
+    public static boolean isEnabled(SharedPreferences prefs) {
+        return prefs.getBoolean(KEY_AMBIENT_MODE, false);
+    }
+
+    /** Start or stop following the video, depending on the preference. */
+    public void update(SharedPreferences prefs) {
+        if (isEnabled(prefs)) start();
+        else stop();
+    }
+
+    public void start() {
+        if (mRunning || Build.VERSION.SDK_INT < Build.VERSION_CODES.N) return;
+        mRunning = true;
+        mCopyThread = new HandlerThread("AmbientMode");
+        mCopyThread.start();
+        mCopyHandler = new Handler(mCopyThread.getLooper());
+        mGlowView.setVisibility(View.VISIBLE);
+        mMainHandler.post(mCapture);
+    }
+
+    public void stop() {
+        if (!mRunning) {
+            mGlowView.setVisibility(View.GONE);
+            return;
+        }
+        mRunning = false;
+        mMainHandler.removeCallbacks(mCapture);
+        mCopyPending = false;
+        if (mCopyThread != null) {
+            mCopyThread.quitSafely();
+            mCopyThread = null;
+            mCopyHandler = null;
+        }
+        mGlowView.setImageDrawable(null);
+        mCurrent = null;
+        mGlowView.setVisibility(View.GONE);
+    }
+
+    private final Runnable mCapture = new Runnable() {
+        @Override
+        public void run() {
+            if (!mRunning) return;
+            mMainHandler.postDelayed(this, CAPTURE_INTERVAL_MS);
+            if (mCopyPending) return;
+            View video = mSurfaceController.getView();
+            if (video == null || video.getVisibility() != View.VISIBLE
+                    || video.getWidth() <= 0 || video.getHeight() <= 0) return;
+            int w = SAMPLE_WIDTH;
+            int h = Math.max(4, Math.round(SAMPLE_WIDTH * video.getHeight() / (float) video.getWidth()));
+            try {
+                if (video instanceof TextureView) {
+                    Bitmap frame = ((TextureView) video).getBitmap(w, h);
+                    if (frame != null) show(frame);
+                } else if (video instanceof SurfaceView && Build.VERSION.SDK_INT >= Build.VERSION_CODES.N) {
+                    SurfaceView surfaceView = (SurfaceView) video;
+                    if (!surfaceView.getHolder().getSurface().isValid() || mCopyHandler == null) return;
+                    final Bitmap frame = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888);
+                    mCopyPending = true;
+                    PixelCopy.request(surfaceView, frame, result -> {
+                        mMainHandler.post(() -> {
+                            mCopyPending = false;
+                            if (mRunning && result == PixelCopy.SUCCESS) show(frame);
+                            else frame.recycle();
+                        });
+                    }, mCopyHandler);
+                }
+            } catch (IllegalArgumentException | IllegalStateException e) {
+                // surface not ready (or protected content): try again on the next tick
+                mCopyPending = false;
+                log.debug("capture: {}", e.getMessage());
+            }
+        }
+    };
+
+    private void show(Bitmap frame) {
+        Bitmap glow = soften(frame);
+        if (glow != frame) frame.recycle();
+        BitmapDrawable next = new BitmapDrawable(mGlowView.getResources(), glow);
+        next.setFilterBitmap(true);
+        Drawable previous = mCurrent != null ? mCurrent : new ColorDrawable(0);
+        TransitionDrawable fade = new TransitionDrawable(new Drawable[] { previous, next });
+        fade.setCrossFadeEnabled(true);
+        mGlowView.setImageDrawable(fade);
+        fade.startTransition(CROSSFADE_MS);
+        mCurrent = next;
+    }
+
+    /**
+     * A tiny frame stretched to full screen shows blocks: blur it a little at a slightly larger
+     * size so the stretch gives smooth gradients even without RenderEffect (before Android 12).
+     */
+    private static Bitmap soften(Bitmap frame) {
+        Bitmap big = Bitmap.createScaledBitmap(frame, frame.getWidth() * 2, frame.getHeight() * 2, true);
+        int w = big.getWidth(), h = big.getHeight();
+        int[] px = new int[w * h];
+        big.getPixels(px, 0, w, 0, 0, w, h);
+        boxBlur(px, w, h, 3);
+        boxBlur(px, w, h, 3);
+        big.setPixels(px, 0, w, 0, 0, w, h);
+        return big;
+    }
+
+    /** Separable box blur, horizontal then vertical, edges clamped. */
+    static void boxBlur(int[] px, int w, int h, int r) {
+        int[] tmp = new int[px.length];
+        blurPass(px, tmp, w, h, r, true);
+        blurPass(tmp, px, w, h, r, false);
+    }
+
+    private static void blurPass(int[] src, int[] dst, int w, int h, int r, boolean horizontal) {
+        int lines = horizontal ? h : w;
+        int len = horizontal ? w : h;
+        int n = 2 * r + 1;
+        for (int line = 0; line < lines; line++) {
+            for (int i = 0; i < len; i++) {
+                int a = 0, red = 0, g = 0, b = 0;
+                for (int k = -r; k <= r; k++) {
+                    int j = Math.min(len - 1, Math.max(0, i + k));
+                    int c = horizontal ? src[line * w + j] : src[j * w + line];
+                    a += c >>> 24;
+                    red += (c >> 16) & 0xff;
+                    g += (c >> 8) & 0xff;
+                    b += c & 0xff;
+                }
+                int out = ((a / n) << 24) | ((red / n) << 16) | ((g / n) << 8) | (b / n);
+                if (horizontal) dst[line * w + i] = out;
+                else dst[i * w + line] = out;
+            }
+        }
+    }
+}
