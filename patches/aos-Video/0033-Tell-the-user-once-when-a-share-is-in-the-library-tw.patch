From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: oop23 <ilidans01yt@gmail.com>
Date: Sat, 10 Oct 2026 05:21:54 +0000
Subject: [PATCH] Tell the user once when a share is in the library twice

---
 res/values-pl/strings.xml                     |  2 ++
 res/values/strings.xml                        |  2 ++
 .../video/browser/MainActivity.java           | 27 +++++++++++++++++++
 3 files changed, 31 insertions(+)

diff --git a/res/values-pl/strings.xml b/res/values-pl/strings.xml
index 49f03ec..55196d9 100644
--- a/res/values-pl/strings.xml
+++ b/res/values-pl/strings.xml
@@ -1017,4 +1017,6 @@
     <string name="preferences_ambient_mode_summary">Delikatna poświata w kolorach filmu wokół obrazu zamiast czarnych pasów (jak tryb kinowy w YouTube)</string>
     <string name="data_source_nfo">NFO</string>
     <string name="data_source_edited">✎ Twoje zmiany</string>
+    <string name="indexed_twice_title">Ten sam udział dwa razy w bibliotece</string>
+    <string name="indexed_twice_message">Te foldery biblioteki to ten sam udział (raz po nazwie serwera, raz po IP), więc filmy są indeksowane i scrapowane dwa razy. Usuń jeden z każdej pary z folderów indeksowanych:</string>
 </resources>
diff --git a/res/values/strings.xml b/res/values/strings.xml
index f8762a0..54c919a 100644
--- a/res/values/strings.xml
+++ b/res/values/strings.xml
@@ -1112,4 +1112,6 @@
     <string name="preferences_ambient_mode_summary">Soft glow in the colors of the video around the picture instead of black bars (like YouTube\'s ambient mode)</string>
     <string name="data_source_nfo">NFO</string>
     <string name="data_source_edited">✎ Your edits</string>
+    <string name="indexed_twice_title">Same share in the library twice</string>
+    <string name="indexed_twice_message">These library folders are the same share reached by server name and by IP, so their videos are indexed and scraped twice. Remove one of each pair from the indexed folders:</string>
 </resources>
diff --git a/src/main/java/com/archos/mediacenter/video/browser/MainActivity.java b/src/main/java/com/archos/mediacenter/video/browser/MainActivity.java
index 0a111f8..e8b5e3f 100644
--- a/src/main/java/com/archos/mediacenter/video/browser/MainActivity.java
+++ b/src/main/java/com/archos/mediacenter/video/browser/MainActivity.java
@@ -611,6 +611,33 @@ public class MainActivity extends BrowserActivity implements ExternalPlayerWithR
                 false, mGlobalResumeContentObserver);
         LoaderManager.getInstance(this).restartLoader(0, null, mNewVideosActionProvider);
         mKeepScreenOnHandler.post(mKeepScreenOnRunnable);
+        warnIfIndexedTwice();
+    }
+
+    private static boolean sIndexedTwiceChecked = false;
+
+    /**
+     * ReNova: libraries indexed before the fix may hold the same share twice (by server name and
+     * by IP), every video then shows up and is scraped twice. Tell the user once per launch.
+     */
+    private void warnIfIndexedTwice() {
+        if (sIndexedTwiceChecked) return;
+        sIndexedTwiceChecked = true;
+        final android.content.Context app = getApplicationContext();
+        new Thread(() -> {
+            final java.util.List<String[]> pairs = com.archos.mediacenter.utils.ShortcutDbAdapter.VIDEO.findIndexedTwice(app);
+            if (pairs.isEmpty()) return;
+            runOnUiThread(() -> {
+                if (isFinishing() || isDestroyed()) return;
+                StringBuilder list = new StringBuilder();
+                for (String[] pair : pairs) list.append("\n• ").append(pair[0]).append("\n   = ").append(pair[1]);
+                new AlertDialog.Builder(MainActivity.this)
+                        .setTitle(R.string.indexed_twice_title)
+                        .setMessage(getString(R.string.indexed_twice_message) + "\n" + list)
+                        .setPositiveButton(android.R.string.ok, null)
+                        .show();
+            });
+        }, "IndexedTwiceCheck").start();
     }
 
 
