+package com.archos.mediacenter.video.ui;
+
+import android.animation.ValueAnimator;
+import android.app.Activity;
+import android.graphics.RenderEffect;
+import android.graphics.Shader;
+import android.os.Build;
+import android.provider.Settings;
+import android.view.View;
+import android.view.animation.DecelerateInterpolator;
+
+/**
+ * First screen after the splash: the UI comes into focus, from blurred, slightly zoomed out and
+ * transparent to sharp. Blur needs Android 12 (RenderEffect); older versions only fade and zoom.
+ * Played once per process, and skipped when the user disabled animations.
+ */
+public final class EntranceAnimation {
+
+    private static boolean sPlayed = false;
+    private static final long DURATION_MS = 520;
+    private static final float START_BLUR_PX = 28f;
+
+    private EntranceAnimation() {}
+
+    public static void playOnce(Activity activity) {
+        if (sPlayed || activity == null) return;
+        sPlayed = true;
+        if (animationsDisabled(activity)) return;
+        final View content = activity.findViewById(android.R.id.content);
+        if (content == null) return;
+        content.setAlpha(0f);
+        content.setScaleX(0.97f);
+        content.setScaleY(0.97f);
+        content.post(() -> {
+            ValueAnimator animator = ValueAnimator.ofFloat(0f, 1f);
+            animator.setDuration(DURATION_MS);
+            animator.setInterpolator(new DecelerateInterpolator(1.6f));
+            animator.addUpdateListener(a -> {
+                float f = (float) a.getAnimatedValue();
+                content.setAlpha(Math.min(1f, f * 1.4f));
+                float scale = 0.97f + 0.03f * f;
+                content.setScaleX(scale);
+                content.setScaleY(scale);
+                if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+                    float radius = START_BLUR_PX * (1f - f);
+                    content.setRenderEffect(radius < 0.5f ? null
+                            : RenderEffect.createBlurEffect(radius, radius, Shader.TileMode.CLAMP));
+                }
+            });
+            animator.addListener(new android.animation.AnimatorListenerAdapter() {
+                @Override
+                public void onAnimationEnd(android.animation.Animator animation) {
+                    reset(content);
+                }
+
+                @Override
+                public void onAnimationCancel(android.animation.Animator animation) {
+                    reset(content);
+                }
+            });
+            animator.start();
+        });
+    }
+
+    private static void reset(View content) {
+        content.setAlpha(1f);
+        content.setScaleX(1f);
+        content.setScaleY(1f);
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) content.setRenderEffect(null);
+    }
+
+    private static boolean animationsDisabled(Activity activity) {
+        try {
+            return Settings.Global.getFloat(activity.getContentResolver(),
+                    Settings.Global.ANIMATOR_DURATION_SCALE, 1f) == 0f;
+        } catch (Exception e) {
+            return false;
+        }
+    }
+}
