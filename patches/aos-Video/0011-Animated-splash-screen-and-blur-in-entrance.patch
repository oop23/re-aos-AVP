+<?xml version="1.0" encoding="utf-8"?>
+<!-- Splash: the renewal arrow spins into place around the play button, then the nova spark flares -->
+<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
+    xmlns:aapt="http://schemas.android.com/aapt">
+    <aapt:attr name="android:drawable">
+        <vector
+            android:width="108dp"
+            android:height="108dp"
+            android:viewportWidth="108"
+            android:viewportHeight="108">
+            <group
+                android:name="arrow"
+                android:pivotX="54"
+                android:pivotY="54"
+                android:rotation="-150">
+                <path
+                    android:pathData="M69.56,38.44 A22,22 0 1,1 46.48,33.33"
+                    android:strokeColor="#FFFFFF"
+                    android:strokeWidth="6"
+                    android:strokeLineCap="round" />
+                <path
+                    android:pathData="M54.2,30.5 L48.3,39.9 L43.9,27.8 Z"
+                    android:fillColor="#FFFFFF"
+                    android:strokeColor="#FFFFFF"
+                    android:strokeWidth="1.5"
+                    android:strokeLineJoin="round" />
+            </group>
+            <path
+                android:pathData="M49.5,44 L49.5,64 L66.5,54 Z"
+                android:fillColor="#FFFFFF"
+                android:strokeColor="#FFFFFF"
+                android:strokeWidth="3"
+                android:strokeLineJoin="round" />
+            <group
+                android:name="spark"
+                android:pivotX="67"
+                android:pivotY="29"
+                android:scaleX="0"
+                android:scaleY="0">
+                <path
+                    android:pathData="M67,23.5 Q67.8,28.2 72.5,29 Q67.8,29.8 67,34.5 Q66.2,29.8 61.5,29 Q66.2,28.2 67,23.5 Z"
+                    android:fillColor="#FFD27A" />
+            </group>
+        </vector>
+    </aapt:attr>
+    <target android:name="arrow">
+        <aapt:attr name="android:animation">
+            <objectAnimator
+                android:duration="650"
+                android:interpolator="@android:interpolator/fast_out_slow_in"
+                android:propertyName="rotation"
+                android:valueFrom="-150"
+                android:valueTo="0"
+                android:valueType="floatType" />
+        </aapt:attr>
+    </target>
+    <target android:name="spark">
+        <aapt:attr name="android:animation">
+            <set android:ordering="sequentially">
+                <set android:ordering="together">
+                    <objectAnimator
+                        android:duration="220"
+                        android:startOffset="480"
+                        android:interpolator="@android:interpolator/fast_out_slow_in"
+                        android:propertyName="scaleX"
+                        android:valueFrom="0"
+                        android:valueTo="1.35"
+                        android:valueType="floatType" />
+                    <objectAnimator
+                        android:duration="220"
+                        android:startOffset="480"
+                        android:interpolator="@android:interpolator/fast_out_slow_in"
+                        android:propertyName="scaleY"
+                        android:valueFrom="0"
+                        android:valueTo="1.35"
+                        android:valueType="floatType" />
+                </set>
+                <set android:ordering="together">
+                    <objectAnimator
+                        android:duration="180"
+                        android:propertyName="scaleX"
+                        android:valueFrom="1.35"
+                        android:valueTo="1"
+                        android:valueType="floatType" />
+                    <objectAnimator
+                        android:duration="180"
+                        android:propertyName="scaleY"
+                        android:valueFrom="1.35"
+                        android:valueTo="1"
+                        android:valueType="floatType" />
+                </set>
+            </set>
+        </aapt:attr>
+    </target>
+</animated-vector>
