+    /** Edit the movie or the episode playing from this path (used by the player). */
+    public static void showForPath(Activity activity, String path) {
+        if (path == null) return;
+        final Context app = activity.getApplicationContext();
+        sExecutor.execute(() -> {
+            BaseTags tags = null;
+            String[] projection = { VideoStore.Video.VideoColumns.SCRAPER_MOVIE_ID, VideoStore.Video.VideoColumns.SCRAPER_EPISODE_ID };
+            try (Cursor c = app.getContentResolver().query(VideoStore.Video.Media.EXTERNAL_CONTENT_URI, projection,
+                    VideoStore.MediaColumns.DATA + "=?", new String[] { path }, null)) {
+                if (c != null && c.moveToFirst()) {
+                    long movieId = c.isNull(0) ? -1 : c.getLong(0);
+                    long episodeId = c.isNull(1) ? -1 : c.getLong(1);
+                    if (movieId > 0) tags = TagsFactory.buildMovieTags(app, movieId);
+                    else if (episodeId > 0) tags = TagsFactory.buildEpisodeTags(app, episodeId);
+                }
+            } catch (Exception e) {
+                log.warn("showForPath: cannot load tags for {}", path, e);
+            }
+            final BaseTags loaded = tags;
+            sMainHandler.post(() -> {
+                if (activity.isFinishing()) return;
+                if (loaded instanceof MovieTags) showDialog(activity, Kind.MOVIE, loaded, path);
+                else if (loaded instanceof EpisodeTags) showDialog(activity, Kind.EPISODE, loaded, path);
+                else Toast.makeText(activity, R.string.metadata_edit_unavailable, Toast.LENGTH_SHORT).show();
+            });
+        });
+    }
+
