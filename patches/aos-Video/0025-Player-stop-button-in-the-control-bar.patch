From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: oop23 <ilidans01yt@gmail.com>
Date: Sat, 10 Oct 2026 05:10:50 +0000
Subject: [PATCH] Player: stop button in the control bar

Next to play/pause in landscape, tablet and TV bars, at the left of the
bar in portrait. The top menu keeps Stop in its overflow.
---
 res/drawable/video_stop.xml                        | 14 ++++++++++++++
 res/layout-land/player_controller_inside.xml       | 13 +++++++++++++
 .../player_controller_inside.xml                   | 13 +++++++++++++
 res/layout-sw600dp/player_controller_inside.xml    | 13 +++++++++++++
 res/layout/player_controller_inside.xml            | 14 ++++++++++++++
 .../mediacenter/video/player/PlayerActivity.java   |  2 +-
 .../mediacenter/video/player/PlayerController.java | 10 ++++++++++
 7 files changed, 78 insertions(+), 1 deletion(-)
 create mode 100644 res/drawable/video_stop.xml

diff --git a/res/drawable/video_stop.xml b/res/drawable/video_stop.xml
new file mode 100644
index 0000000..d0a189a
--- /dev/null
+++ b/res/drawable/video_stop.xml
@@ -0,0 +1,14 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- ReNova: stop button of the player bar (same visual weight as rewind / forward) -->
+<vector xmlns:android="http://schemas.android.com/apk/res/android"
+    android:width="40dp"
+    android:height="40dp"
+    android:viewportWidth="40"
+    android:viewportHeight="40">
+    <path
+        android:fillColor="#33000000"
+        android:pathData="M14,14.8h12a3,3 0 0 1 3,3v12a3,3 0 0 1 -3,3h-12a3,3 0 0 1 -3,-3v-12a3,3 0 0 1 3,-3z" />
+    <path
+        android:fillColor="#F2FFFFFF"
+        android:pathData="M14,13h12a3,3 0 0 1 3,3v12a3,3 0 0 1 -3,3h-12a3,3 0 0 1 -3,-3v-12a3,3 0 0 1 3,-3z" />
+</vector>
