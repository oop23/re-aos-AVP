diff --git a/src/main/java/com/archos/mediacenter/video/player/PlayerActivity.java b/src/main/java/com/archos/mediacenter/video/player/PlayerActivity.java
index 3f6b0d3..e32b126 100644
--- a/src/main/java/com/archos/mediacenter/video/player/PlayerActivity.java
+++ b/src/main/java/com/archos/mediacenter/video/player/PlayerActivity.java
@@ -2587,7 +2587,7 @@ public class PlayerActivity extends AppCompatActivity implements PlayerControlle
             //------------------------------------------------------------------
             // ReNova: an explicit Stop, like every player (back used to be the only way out)
             menu.add(MENU_FILE_ACTIONS_GROUP, MENU_STOP_ID, Menu.NONE, R.string.player_stop)
-                    .setIcon(R.drawable.ic_menu_stop).setShowAsAction(MenuItem.SHOW_AS_ACTION_ALWAYS);
+                    .setIcon(R.drawable.ic_menu_stop).setShowAsAction(MenuItem.SHOW_AS_ACTION_NEVER); // the bar has a stop button
             mInfoMenuItem = menu.add(MENU_FILE_ACTIONS_GROUP, MENU_INFO_ID, Menu.NONE, R.string.menu_info);
             if (mInfoMenuItem != null) {
                 mInfoMenuItem.setIcon(R.drawable.ic_menu_info).setShowAsAction(MenuItem.SHOW_AS_ACTION_ALWAYS);
diff --git a/src/main/java/com/archos/mediacenter/video/player/PlayerController.java b/src/main/java/com/archos/mediacenter/video/player/PlayerController.java
index f67da34..260aee1 100644
--- a/src/main/java/com/archos/mediacenter/video/player/PlayerController.java
+++ b/src/main/java/com/archos/mediacenter/video/player/PlayerController.java
@@ -495,6 +495,16 @@ public class PlayerController implements View.OnTouchListener, OnGenericMotionLi
             mFormatButton.setOnClickListener(mFormatListener);
         }
 
+        // ReNova: stop in the bar, same path as back (the resume point is saved on the way out)
+        ImageButton stopButton = (ImageButton) v.findViewById(R.id.stop);
+        if (stopButton != null) {
+            if (mContext instanceof android.app.Activity) {
+                stopButton.setOnClickListener(view -> ((android.app.Activity) mContext).finish());
+            } else {
+                stopButton.setVisibility(View.GONE);
+            }
+        }
+
