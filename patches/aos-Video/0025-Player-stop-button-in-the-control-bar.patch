+            android:scaleType="fitCenter"
+            android:adjustViewBounds="true"
+            ads:srcCompat="@drawable/video_stop"
+            android:contentDescription="@string/player_stop" />
+
+
         <ImageButton
             android:id="@+id/backward"
             style="@style/PlayerControlButton"
