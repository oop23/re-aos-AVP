+++ b/res/layout-land/player_controller_inside.xml
@@ -72,6 +72,19 @@
             ads:srcCompat="@drawable/video_play_selector"
         android:contentDescription="@string/play_selection" />
 
+        <ImageButton
+            android:id="@+id/stop"
+            style="@style/PlayerControlButton"
+            android:layout_marginStart="@dimen/player_button_margin_half"
+            android:layout_marginEnd="@dimen/player_button_margin_half"
