+    /**
+     * ReNova: the microphone only serves voice search with TV remotes, a phone never asks for it.
+     */
+    private static void requestPermissions(Activity activity, String[] permissions, int requestCode) {
+        boolean tv = ArchosFeatures.isAndroidTV(activity);
+        List<String> wanted = new ArrayList<>();
+        for (String permission : permissions) {
+            if (tv || !Manifest.permission.RECORD_AUDIO.equals(permission)) wanted.add(permission);
+        }
+        ActivityCompat.requestPermissions(activity, wanted.toArray(new String[0]), requestCode);
+    }
