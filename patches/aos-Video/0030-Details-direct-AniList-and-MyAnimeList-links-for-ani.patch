+        mMalIcon.setVisibility(mMalId > 0 ? View.VISIBLE : View.GONE);
         mNfoSourceChip.setVisibility(DataSources.isNfo(context, mCurrentVideo.getFilePath()) ? View.VISIBLE : View.GONE);
         boolean edited = MetadataOverrides.has(context, itemOverrideKey)
                 || (showOverrideKey != null && MetadataOverrides.has(context, showOverrideKey));
