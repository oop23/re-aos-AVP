diff --git a/res/drawable/data_source_chip_mal.xml b/res/drawable/data_source_chip_mal.xml
new file mode 100644
index 0000000..1dd0570
--- /dev/null
+++ b/res/drawable/data_source_chip_mal.xml
@@ -0,0 +1,10 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- MyAnimeList link: their blue -->
+<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#40FFFFFF">
+    <item>
+        <shape android:shape="rectangle">
+            <corners android:radius="8dp" />
+            <solid android:color="#2E51A2" />
+        </shape>
+    </item>
+</ripple>
diff --git a/res/layout/video_info2_scraper.xml b/res/layout/video_info2_scraper.xml
index 1a8a41d..b36e2cd 100644
--- a/res/layout/video_info2_scraper.xml
+++ b/res/layout/video_info2_scraper.xml
@@ -109,6 +109,14 @@
                     android:contentDescription="AniList"
                     tools:ignore="HardcodedText" />
 
+                <TextView
+                    android:id="@+id/scrap_link_mal"
+                    style="@style/DataSourceChip"
+                    android:background="@drawable/data_source_chip_mal"
+                    android:text="MAL"
+                    android:contentDescription="MyAnimeList"
+                    tools:ignore="HardcodedText" />
+
                 <TextView
                     android:id="@+id/scrap_source_nfo"
                     style="@style/DataSourceChip"
diff --git a/src/main/java/com/archos/mediacenter/video/info/VideoInfoActivityFragment.java b/src/main/java/com/archos/mediacenter/video/info/VideoInfoActivityFragment.java
