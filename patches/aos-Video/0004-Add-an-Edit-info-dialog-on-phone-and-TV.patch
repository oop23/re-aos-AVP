+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package com.archos.mediacenter.video.info;
+
+import android.app.Activity;
+import android.content.Context;
+import android.os.Handler;
+import android.os.Looper;
+import android.text.TextUtils;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.widget.Button;
+import android.widget.Toast;
+
+import androidx.appcompat.app.AlertDialog;
+import androidx.appcompat.view.ContextThemeWrapper;
+
+import com.archos.mediacenter.video.R;
+import com.archos.mediacenter.video.browser.adapters.object.Episode;
+import com.archos.mediacenter.video.browser.adapters.object.Movie;
+import com.archos.mediacenter.video.browser.adapters.object.Video;
+import com.archos.mediascraper.BaseTags;
+import com.archos.mediascraper.EpisodeTags;
+import com.archos.mediascraper.MetadataOverrides;
+import com.archos.mediascraper.MovieTags;
+import com.archos.mediascraper.ShowTags;
+import com.archos.mediascraper.TagsFactory;
+import com.google.android.material.dialog.MaterialAlertDialogBuilder;
+import com.google.android.material.textfield.TextInputEditText;
+import com.google.android.material.textfield.TextInputLayout;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import java.util.Locale;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+/**
+ * Edit the scraped info of a movie, an episode or a TV show.
+ *
+ * Works from any activity (phone AppCompat screens and leanback TV screens): the dialog brings its
+ * own Material 3 theme. Changes go to the device database only, never to the media source, and are
+ * remembered by {@link MetadataOverrides} so a later scrape does not undo them.
+ */
+public final class MetadataEditDialog {
+
+    private static final Logger log = LoggerFactory.getLogger(MetadataEditDialog.class);
+
+    private static final ExecutorService sExecutor = Executors.newSingleThreadExecutor();
+    private static final Handler sMainHandler = new Handler(Looper.getMainLooper());
+
+    private enum Kind { MOVIE, EPISODE, SHOW }
+
+    private MetadataEditDialog() {}
+
+    /** Edit the movie or the episode behind this video. */
+    public static void show(Activity activity, Video video) {
+        if (video == null) return;
+        final Context app = activity.getApplicationContext();
+        final String path = video.getFilePath();
+        sExecutor.execute(() -> {
+            BaseTags tags = null;
+            if (video instanceof Movie || video instanceof Episode) {
+                try {
+                    tags = video.getFullScraperTags(app);
+                } catch (Exception e) {
+                    log.warn("show: cannot load tags for {}", path, e);
+                }
+            }
+            final BaseTags loaded = tags;
+            sMainHandler.post(() -> {
+                if (activity.isFinishing()) return;
+                if (loaded instanceof MovieTags) showDialog(activity, Kind.MOVIE, loaded, path);
+                else if (loaded instanceof EpisodeTags) showDialog(activity, Kind.EPISODE, loaded, path);
+                else Toast.makeText(activity, R.string.metadata_edit_unavailable, Toast.LENGTH_SHORT).show();
+            });
+        });
+    }
+
+    /** Edit a TV show from its scraper database id. */
+    public static void showForShow(Activity activity, long showId) {
+        final Context app = activity.getApplicationContext();
+        sExecutor.execute(() -> {
+            ShowTags tags = null;
+            try {
+                tags = TagsFactory.buildShowTags(app, showId);
+            } catch (Exception e) {
+                log.warn("showForShow: cannot load show {}", showId, e);
+            }
+            final ShowTags loaded = tags;
+            sMainHandler.post(() -> {
+                if (activity.isFinishing()) return;
+                if (loaded != null) showDialog(activity, Kind.SHOW, loaded, null);
+                else Toast.makeText(activity, R.string.metadata_edit_unavailable, Toast.LENGTH_SHORT).show();
+            });
+        });
+    }
+
+    private static void showDialog(Activity activity, Kind kind, BaseTags tags, String path) {
+        Context themed = new ContextThemeWrapper(activity, R.style.MetadataEditDialogTheme);
+        View view = LayoutInflater.from(themed).inflate(R.layout.dialog_edit_metadata, null);
+        Fields f = new Fields(view);
+
+        f.title.setText(tags.getTitle());
+        f.plot.setText(tags.getPlot());
+        if (tags.getRating() > 0) f.rating.setText(formatRating(tags.getRating()));
+
+        f.yearLayout.setVisibility(kind == Kind.EPISODE ? View.GONE : View.VISIBLE);
+        f.seasonLayout.setVisibility(kind == Kind.EPISODE ? View.VISIBLE : View.GONE);
+        f.episodeLayout.setVisibility(kind == Kind.EPISODE ? View.VISIBLE : View.GONE);
+        f.contentRatingLayout.setVisibility(kind == Kind.MOVIE ? View.VISIBLE : View.GONE);
+
+        String overrideKey = null;
+        switch (kind) {
+            case MOVIE: {
+                MovieTags m = (MovieTags) tags;
+                if (m.getYear() > 0) f.year.setText(String.valueOf(m.getYear()));
+                f.contentRating.setText(m.getContentRating());
+                overrideKey = path == null ? null : MetadataOverrides.movieKey(path);
+                break;
+            }
+            case EPISODE: {
+                EpisodeTags e = (EpisodeTags) tags;
+                f.season.setText(String.valueOf(e.getSeason()));
+                f.episode.setText(String.valueOf(e.getEpisode()));
+                overrideKey = path == null ? null : MetadataOverrides.episodeKey(path);
+                break;
+            }
+            case SHOW: {
+                ShowTags s = (ShowTags) tags;
+                if (s.getPremieredYear() > 0) f.year.setText(String.valueOf(s.getPremieredYear()));
+                overrideKey = s.getOnlineId() > 0 ? MetadataOverrides.showKey(s.getOnlineId()) : null;
+                break;
+            }
+        }
+
+        MaterialAlertDialogBuilder builder = new MaterialAlertDialogBuilder(themed)
+                .setTitle(kind == Kind.SHOW ? R.string.metadata_edit_show : R.string.metadata_edit)
+                .setView(view)
+                .setPositiveButton(R.string.metadata_edit_save, null)
+                .setNegativeButton(android.R.string.cancel, null);
+        final String key = overrideKey;
+        if (key != null && MetadataOverrides.has(activity, key)) {
+            builder.setNeutralButton(R.string.metadata_edit_reset, (d, w) -> {
+                MetadataOverrides.clear(activity, key);
+                Toast.makeText(activity, R.string.metadata_edit_reset_done, Toast.LENGTH_LONG).show();
+            });
+        } else if (kind == Kind.EPISODE && ((EpisodeTags) tags).getShowId() > 0) {
+            final long showId = ((EpisodeTags) tags).getShowId();
+            builder.setNeutralButton(R.string.metadata_edit_show, (d, w) -> showForShow(activity, showId));
+        }
+        AlertDialog dialog = builder.create();
+        dialog.setOnShowListener(d -> {
+            Button save = dialog.getButton(AlertDialog.BUTTON_POSITIVE);
+            save.setOnClickListener(v -> {
+                JSONObject edits = collect(kind, f);
+                if (edits == null) {
+                    Toast.makeText(activity, R.string.metadata_edit_invalid, Toast.LENGTH_SHORT).show();
+                    return;
+                }
+                final Context app = activity.getApplicationContext();
+                sExecutor.execute(() -> {
+                    switch (kind) {
+                        case MOVIE: MetadataOverrides.editMovie(app, tags.getId(), path, edits); break;
+                        case EPISODE: MetadataOverrides.editEpisode(app, tags.getId(), path, edits); break;
+                        case SHOW: MetadataOverrides.editShow(app, tags.getId(), tags.getOnlineId(), edits); break;
+                    }
+                    sMainHandler.post(() -> Toast.makeText(app, R.string.metadata_edit_saved, Toast.LENGTH_SHORT).show());
+                });
+                dialog.dismiss();
+            });
+        });
+        dialog.show();
+        f.title.requestFocus();
+    }
+
+    /** @return the edits, or null when a field is invalid (the field then shows an error) */
+    private static JSONObject collect(Kind kind, Fields f) {
+        boolean ok = true;
+        JSONObject edits = new JSONObject();
+        try {
+            String title = text(f.title);
+            if (TextUtils.isEmpty(title)) {
+                f.titleLayout.setError(" ");
+                ok = false;
+            } else {
+                f.titleLayout.setError(null);
+                edits.put(MetadataOverrides.TITLE, title);
+            }
+            edits.put(MetadataOverrides.PLOT, text(f.plot));
+
+            String rating = text(f.rating).replace(',', '.');
+            f.ratingLayout.setError(null);
+            if (!rating.isEmpty()) {
+                Float r = parseFloat(rating);
+                if (r == null || r < 0 || r > 10) { f.ratingLayout.setError(" "); ok = false; }
+                else edits.put(MetadataOverrides.RATING, r.doubleValue());
+            }
+
+            if (kind != Kind.EPISODE) {
+                String year = text(f.year);
+                f.yearLayout.setError(null);
+                if (!year.isEmpty()) {
+                    Integer y = parseInt(year);
+                    if (y == null || y < 1870 || y > 2200) { f.yearLayout.setError(" "); ok = false; }
+                    else edits.put(MetadataOverrides.YEAR, y.intValue());
+                }
+            }
+            if (kind == Kind.MOVIE) {
+                edits.put(MetadataOverrides.CONTENT_RATING, text(f.contentRating));
+            }
+            if (kind == Kind.EPISODE) {
+                Integer season = parseInt(text(f.season));
+                Integer episode = parseInt(text(f.episode));
+                f.seasonLayout.setError(season == null || season < 0 ? " " : null);
+                f.episodeLayout.setError(episode == null || episode < 0 ? " " : null);
+                if (season == null || season < 0 || episode == null || episode < 0) ok = false;
+                else {
+                    edits.put(MetadataOverrides.SEASON, season.intValue());
+                    edits.put(MetadataOverrides.EPISODE, episode.intValue());
+                }
+            }
+        } catch (JSONException e) {
+            log.error("collect: failed", e);
+            return null;
+        }
+        return ok ? edits : null;
+    }
+
+    private static String text(TextInputEditText e) {
+        return e.getText() == null ? "" : e.getText().toString().trim();
+    }
+
+    private static Integer parseInt(String s) {
+        try { return Integer.valueOf(s); } catch (NumberFormatException e) { return null; }
+    }
+
+    private static Float parseFloat(String s) {
+        try { return Float.valueOf(s); } catch (NumberFormatException e) { return null; }
+    }
+
+    private static String formatRating(float rating) {
+        return String.format(Locale.ROOT, "%.1f", rating);
+    }
+
+    private static final class Fields {
+        final TextInputLayout titleLayout, yearLayout, seasonLayout, episodeLayout, ratingLayout, contentRatingLayout;
+        final TextInputEditText title, year, season, episode, rating, contentRating, plot;
+
+        Fields(View v) {
+            titleLayout = v.findViewById(R.id.edit_metadata_title_layout);
+            yearLayout = v.findViewById(R.id.edit_metadata_year_layout);
+            seasonLayout = v.findViewById(R.id.edit_metadata_season_layout);
+            episodeLayout = v.findViewById(R.id.edit_metadata_episode_layout);
+            ratingLayout = v.findViewById(R.id.edit_metadata_rating_layout);
+            contentRatingLayout = v.findViewById(R.id.edit_metadata_content_rating_layout);
+            title = v.findViewById(R.id.edit_metadata_title);
+            year = v.findViewById(R.id.edit_metadata_year);
+            season = v.findViewById(R.id.edit_metadata_season);
+            episode = v.findViewById(R.id.edit_metadata_episode);
+            rating = v.findViewById(R.id.edit_metadata_rating);
+            contentRating = v.findViewById(R.id.edit_metadata_content_rating);
+            plot = v.findViewById(R.id.edit_metadata_plot);
+        }
+    }
+}
