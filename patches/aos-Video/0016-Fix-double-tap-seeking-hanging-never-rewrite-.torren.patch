+    // ReNova: double tap seeks are accumulated (3 taps = 30 s) into ONE clamped seek sent after the
+    // last tap. Each tap used to fire its own seek from the current position, unclamped: rapid taps
+    // flooded the engine and a seek before 0 or past the end kept network files buffering forever.
+    private static final int TAP_SEEK_STEP_MS = 10_000;
+    private static final long TAP_SEEK_DEBOUNCE_MS = 350;
+    private int mTapSeekBaseMs = -1;
+    private int mTapSeekTargetMs = -1;
+    private final Runnable mApplyTapSeek = new Runnable() {
+        @Override
+        public void run() {
+            if (mTapSeekTargetMs >= 0 && Player.sPlayer.isInPlaybackState()) {
+                if (log.isDebugEnabled()) log.debug("mApplyTapSeek: seek to {}", mTapSeekTargetMs);
+                Player.sPlayer.seekTo(mTapSeekTargetMs);
+            }
+            mTapSeekBaseMs = mTapSeekTargetMs = -1;
+            hideOsdHandler.removeCallbacks(hideOsdRunnable);
+            hideOsdHandler.postDelayed(hideOsdRunnable, 700);
+        }
+    };
+
+    private void queueTapSeek(int deltaMs, TextView osd, int iconRes) {
+        int duration = Player.sPlayer.getDuration();
+        if (mTapSeekTargetMs < 0) {
+            mTapSeekBaseMs = Player.sPlayer.getCurrentPosition();
+            mTapSeekTargetMs = mTapSeekBaseMs;
+        }
+        int max = duration > 0 ? Math.max(0, duration - 2000) : Integer.MAX_VALUE;
+        mTapSeekTargetMs = Math.max(0, Math.min(mTapSeekTargetMs + deltaMs, max));
+        if (osd != null) {
+            int delta = mTapSeekTargetMs - mTapSeekBaseMs;
+            String sign = delta < 0 ? "-" : "+";
+            osd.setText(sign + MediaUtils.formatTime(Math.max(1000, Math.abs(delta)))
+                    + "   " + MediaUtils.formatTime(Math.max(1000, mTapSeekTargetMs)));
+            osd.setCompoundDrawablesWithIntrinsicBounds(getDrawable(mContext, iconRes), null, null, null);
+            osd.setVisibility(View.VISIBLE);
+            hideOsdHandler.removeCallbacks(hideOsdRunnable);
+        }
+        mHandler.removeCallbacks(mApplyTapSeek);
+        mHandler.postDelayed(mApplyTapSeek, TAP_SEEK_DEBOUNCE_MS);
+    }
+
