+    /** Credit where the info comes from, next to the TMDb / IMDb logos. */
+    private void showDataSources(long tmdbShowId, String itemOverrideKey, String showOverrideKey) {
+        Context context = getContext();
+        if (context == null || mCurrentVideo == null) return;
+        mAniListIcon.setVisibility(DataSources.isAniListShow(context, tmdbShowId) ? View.VISIBLE : View.GONE);
+        mNfoSourceChip.setVisibility(DataSources.isNfo(context, mCurrentVideo.getFilePath()) ? View.VISIBLE : View.GONE);
+        boolean edited = MetadataOverrides.has(context, itemOverrideKey)
+                || (showOverrideKey != null && MetadataOverrides.has(context, showOverrideKey));
+        mEditedSourceChip.setVisibility(edited ? View.VISIBLE : View.GONE);
+    }
+
     private void selectNewPoster() {
         Intent intent = new Intent(getActivity(), VideoInfoPosterBackdropActivity.class);
         intent.putExtra(VideoInfoPosterBackdropActivity.EXTRA_VIDEO, mCurrentVideo);
