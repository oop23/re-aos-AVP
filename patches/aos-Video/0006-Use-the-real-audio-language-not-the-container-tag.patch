From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: oop23 <ilidans01yt@gmail.com>
Date: Sat, 10 Oct 2026 04:10:28 +0000
Subject: [PATCH] Use the real audio language, not the container tag

Audio track languages now come from TrackLanguageHints: the track title
wins over the container tag, and a polish release name fixes the
language of a single (or the default) untitled track. The preferred
audio language selection and the track names follow.
---
 .../video/utils/VideoMetadata.java            | 38 +++++++++++++++++--
 1 file changed, 35 insertions(+), 3 deletions(-)

diff --git a/src/main/java/com/archos/mediacenter/video/utils/VideoMetadata.java b/src/main/java/com/archos/mediacenter/video/utils/VideoMetadata.java
index 6c7c94b..1eb94b8 100644
--- a/src/main/java/com/archos/mediacenter/video/utils/VideoMetadata.java
+++ b/src/main/java/com/archos/mediacenter/video/utils/VideoMetadata.java
@@ -21,6 +21,7 @@ import android.net.Uri;
 import android.provider.MediaStore;
 
 import com.archos.filecorelibrary.FileUtils;
+import com.archos.mediacenter.utils.TrackLanguageHints;
 import com.archos.mediacenter.filecoreextension.UriUtils;
 import com.archos.medialib.IMediaMetadataRetriever;
 import com.archos.medialib.IMediaPlayer;
@@ -30,6 +31,7 @@ import com.archos.medialib.MediaMetadata;
 import com.archos.mediaprovider.video.VideoStore;
 
 import org.json.JSONObject;
+
 import org.slf4j.Logger;
 import org.slf4j.LoggerFactory;
 
@@ -127,7 +129,8 @@ public class VideoMetadata implements Serializable {
             channels = getMetadataString(data, gapKey + IMediaPlayer.METADATA_KEY_AUDIO_TRACK_CHANNELS);
             vbr = getMetadataBool(data, gapKey + IMediaPlayer.METADATA_KEY_AUDIO_TRACK_VBR);
             supported = getMetadataBool(data, gapKey + IMediaPlayer.METADATA_KEY_AUDIO_TRACK_SUPPORTED);
-            language = getMetadataString(data, gapKey + IMediaPlayer.METADATA_KEY_AUDIO_TRACK_LANGUAGE);
+            // the track title ("Lektor PL", "Dubbing") beats a wrong container tag ("eng")
+            language = TrackLanguageHints.effectiveLanguage(name, getMetadataString(data, gapKey + IMediaPlayer.METADATA_KEY_AUDIO_TRACK_LANGUAGE));
             disposition = getMetadataInt(data, gapKey + IMediaPlayer.METADATA_KEY_AUDIO_TRACK_DISPOSITION);
             if (log.isDebugEnabled()) log.debug("AudioTrack name={}, format={}, language={}, disposition={}", name, format, language, disposition);
         }
@@ -142,7 +145,8 @@ public class VideoMetadata implements Serializable {
             channels = getMetadataRetrieverString(retriever, gapKey + IMediaMetadataRetriever.METADATA_KEY_AUDIO_TRACK_CHANNELS);
             vbr = getMetadataRetrieverBool(retriever, gapKey + IMediaMetadataRetriever.METADATA_KEY_AUDIO_TRACK_VBR);
             supported = getMetadataRetrieverBool(retriever, gapKey + IMediaMetadataRetriever.METADATA_KEY_AUDIO_TRACK_SUPPORTED);
-            language = getMetadataRetrieverString(retriever, gapKey + IMediaMetadataRetriever.METADATA_KEY_AUDIO_TRACK_LANGUAGE);
+            // the track title ("Lektor PL", "Dubbing") beats a wrong container tag ("eng")
+            language = TrackLanguageHints.effectiveLanguage(name, getMetadataRetrieverString(retriever, gapKey + IMediaMetadataRetriever.METADATA_KEY_AUDIO_TRACK_LANGUAGE));
             disposition = getMetadataRetrieverInt(retriever, gapKey + IMediaMetadataRetriever.METADATA_KEY_AUDIO_TRACK_DISPOSITION);
             if (log.isDebugEnabled()) log.debug("AudioTrack name={}, format={}, disposition={}", name, format, disposition);
         }
@@ -154,7 +158,7 @@ public class VideoMetadata implements Serializable {
         public final String  channels;
         public final boolean vbr;
         public final boolean supported;
-        public final String  language;
+        public String  language; // not final: may be corrected from the release name, see applyFileNameAudioHint
         public final int     disposition;
     }
 
@@ -233,6 +237,32 @@ public class VideoMetadata implements Serializable {
         mFileSize = 0;
     }
 
+    /**
+     * "Film.2020.PL.LEKTOR.mkv" with its single audio track tagged "eng": the release name is right.
+     * With several tracks all sharing the same tag (so the tags carry no information), the default
+     * track (or the first one) is the voice-over, as polish releases mux it.
+     */
+    private void applyFileNameAudioHint() {
+        if (mAudioTrackList == null || mAudioTrackList.length == 0) return;
+        String path = mFile != null ? mFile.getName() : mRemotePath;
+        String hinted = TrackLanguageHints.fromFileName(path == null ? null : Uri.decode(path));
+        if (hinted == null) return;
+        for (AudioTrack track : mAudioTrackList) {
+            // a title already naming the language means the tracks are labelled: trust them
+            if (TrackLanguageHints.fromTitle(track.name) != null) return;
+        }
+        String first = mAudioTrackList[0].language;
+        for (AudioTrack track : mAudioTrackList) {
+            if (first == null ? track.language != null : !first.equals(track.language)) return;
+        }
+        AudioTrack target = mAudioTrackList[0];
+        for (AudioTrack track : mAudioTrackList) {
+            if ((track.disposition & VideoUtils.AV_DISPOSITION_DEFAULT) != 0) { target = track; break; }
+        }
+        if (log.isDebugEnabled()) log.debug("applyFileNameAudioHint: {} -> audio track {} is {}", path, target.name, hinted);
+        target.language = hinted;
+    }
+
     public void setFile(String path) {
         mFile = new File(path);
     }
@@ -258,6 +288,7 @@ public class VideoMetadata implements Serializable {
             mAudioTrackList = new AudioTrack[nbTrack];
             for (int i = 0; i < nbTrack; ++i)
                 mAudioTrackList[i] = new AudioTrack(data, i);
+            applyFileNameAudioHint();
         }
         if (data.has(IMediaPlayer.METADATA_KEY_NB_SUBTITLE_TRACK) && (nbTrack = data.getInt(IMediaPlayer.METADATA_KEY_NB_SUBTITLE_TRACK)) > 0) {
             mSubtitleTrackList = new SubtitleTrack[nbTrack];
@@ -301,6 +332,7 @@ public class VideoMetadata implements Serializable {
                 mAudioTrackList = new AudioTrack[nbTrack];
                 for (int i = 0; i < nbTrack; ++i)
                     mAudioTrackList[i] = new AudioTrack(retriever, i);
+                applyFileNameAudioHint();
             }
             nbTrack = getMetadataRetrieverInt(retriever, IMediaMetadataRetriever.METADATA_KEY_NB_SUBTITLE_TRACK);
             if (nbTrack > 0) {
