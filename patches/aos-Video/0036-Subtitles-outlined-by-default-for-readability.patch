From: oop23 <ilidans01yt@gmail.com>
Date: Sat, 10 Oct 2026 05:23:37 +0000
Subject: [PATCH] Subtitles outlined by default for readability

---
 .../com/archos/mediacenter/video/player/PlayerActivity.java     | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/main/java/com/archos/mediacenter/video/player/PlayerActivity.java b/src/main/java/com/archos/mediacenter/video/player/PlayerActivity.java
index 2547ca3..01f3bea 100644
--- a/src/main/java/com/archos/mediacenter/video/player/PlayerActivity.java
+++ b/src/main/java/com/archos/mediacenter/video/player/PlayerActivity.java
@@ -801,7 +801,7 @@ public class PlayerActivity extends AppCompatActivity implements PlayerControlle
         mSubtitleSizeDefault = getResources().getInteger(R.integer.player_pref_subtitle_size_default);
         mSubtitleVPosDefault = getResources().getInteger(R.integer.player_pref_subtitle_vpos_default);
         mSubtitleColorDefault = Color.parseColor(getResources().getString(R.string.subtitle_color_default));
-        mSubtitleOutlineDefault = false;
+        mSubtitleOutlineDefault = true; // ReNova: outlined subtitles stay readable on bright scenes
         mSurfaceController = new SurfaceController(mRootView);
         mSurfaceController.mFullScreenWithCutout = mFullScreenWithCutout;
         mSurfaceController.mCutBothSidesX = cutBothSidesX;
