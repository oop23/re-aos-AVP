 res/values-pl/strings.xml                     |  1 +
 res/values/strings.xml                        |  1 +
 .../video/player/PlayerActivity.java          |  8 ++++
 .../video/player/PlayerBrightnessManager.java | 18 ++------
 .../video/player/PlayerController.java        | 46 ++++++++++++++++++-
 6 files changed, 71 insertions(+), 14 deletions(-)
 create mode 100644 res/drawable/ic_menu_stop.xml

