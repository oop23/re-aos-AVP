     private final float         BORDER_WIDTH = MiscUtils.dp2Px(24);
     private final float         SCROLL_THRESHOLD = MiscUtils.dp2Px(16);
     private final float         SCROLL_ANGLE = 30;
+    // ReNova: horizontal swipe seeks, Kodi/MX style: the full screen width is 90 seconds
+    private static final int    SWIPE_SEEK_FULL_WIDTH_MS = 90_000;
+    private boolean             mSwipeSeeking = false;
+    private int                 mSwipeSeekStartMs = 0;
+    private int                 mSwipeSeekTargetMs = 0;
     private SeekBar             mProgress;
     private SeekBar             mProgress2;
     private TextView            mEndTime, mCurrentTime;
@@ -1892,7 +1897,19 @@ public class PlayerController implements View.OnTouchListener, OnGenericMotionLi
     @SuppressLint("ClickableViewAccessibility")
     public boolean onTouch(View v, MotionEvent event) {
         if (event == null) return false;
-        return gestureDetector.onTouchEvent(event);
+        boolean handled = gestureDetector.onTouchEvent(event);
+        int action = event.getActionMasked();
+        if (mSwipeSeeking && (action == MotionEvent.ACTION_UP || action == MotionEvent.ACTION_CANCEL)) {
+            mSwipeSeeking = false;
+            if (action == MotionEvent.ACTION_UP && Player.sPlayer.isInPlaybackState()) {
+                if (log.isDebugEnabled()) log.debug("onTouch: swipe seek to {}", mSwipeSeekTargetMs);
+                Player.sPlayer.seekTo(mSwipeSeekTargetMs);
+            }
+            hideOsdHandler.removeCallbacks(hideOsdRunnable);
+            hideOsdHandler.postDelayed(hideOsdRunnable, 600);
+            return true;
+        }
+        return handled;
     }
 
     @Override
@@ -2054,6 +2071,22 @@ public class PlayerController implements View.OnTouchListener, OnGenericMotionLi
         boolean isVerticalScroll = (angleDegrees >= 90-SCROLL_ANGLE && angleDegrees <= 90+SCROLL_ANGLE) || (angleDegrees >= 270-SCROLL_ANGLE && angleDegrees <= 270+SCROLL_ANGLE);
         //boolean isVerticalScroll = (Math.abs(distanceY) > Math.abs(distanceX));
 
+        // horizontal swipe: seek preview while the finger moves, applied when it is lifted
+        float totalDx = e2.getX() - e1.getX();
+        if (!mSwipeSeeking && !isVerticalScroll && Math.abs(totalDx) > SCROLL_THRESHOLD * 2
+                && Math.abs(totalDx) > Math.abs(e2.getY() - e1.getY()) * 2
+                && Player.sPlayer.isInPlaybackState() && Player.sPlayer.getDuration() > 0) {
+            mSwipeSeeking = true;
+            mSwipeSeekStartMs = Player.sPlayer.getCurrentPosition();
+        }
+        if (mSwipeSeeking) {
+            int duration = Player.sPlayer.getDuration();
+            int delta = (int) (totalDx / screenWidth * SWIPE_SEEK_FULL_WIDTH_MS);
+            mSwipeSeekTargetMs = Math.max(0, Math.min(mSwipeSeekStartMs + delta, Math.max(0, duration - 1000)));
+            showSwipeSeekOsd(mSwipeSeekTargetMs - mSwipeSeekStartMs, mSwipeSeekTargetMs);
+            return true;
+        }
+
         if (Math.abs(scrollGestureVertical) > SCROLL_THRESHOLD && isVerticalScroll) {
             if (e1.getX() < halfWidth) { // left screen part
                 if (log.isDebugEnabled()) log.debug("onScroll: left screen part, direction={}", (scrollGestureVertical > 0 ? "up" : "down"));
@@ -2222,6 +2255,17 @@ public class PlayerController implements View.OnTouchListener, OnGenericMotionLi
         hideOsdHandler.postDelayed(hideOsdRunnable, 300);
     }
 
+    private void showSwipeSeekOsd(int deltaMs, int targetMs) {
+        if (mOsdRightTextView == null) return;
+        String sign = deltaMs < 0 ? "-" : "+";
+        String text = sign + MediaUtils.formatTime(Math.abs(deltaMs) < 1000 ? 1000 : Math.abs(deltaMs))
+                + "   " + MediaUtils.formatTime(Math.max(1000, targetMs));
+        mOsdRightTextView.setCompoundDrawablesWithIntrinsicBounds(null, null, null, null);
+        mOsdRightTextView.setText(text);
+        mOsdRightTextView.setVisibility(View.VISIBLE);
+        hideOsdHandler.removeCallbacks(hideOsdRunnable);
+    }
+
     public void showAudioSpeedOSD(float audioSpeed) {
         String speedText = String.format(Locale.getDefault(), "%.2fx", audioSpeed);
         if (mOsdRightTextView != null) {
