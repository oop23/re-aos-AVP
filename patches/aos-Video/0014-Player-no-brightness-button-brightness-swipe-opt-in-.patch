+    /** soft dark shadow so white texts stay readable on bright scenes */
+    private static void applyReadableShadow(View view) {
+        if (view instanceof TextView) {
+            ((TextView) view).setShadowLayer(6f, 0f, 1.5f, 0xCC000000);
+        }
+    }
+
     private void showSwipeSeekOsd(int deltaMs, int targetMs) {
