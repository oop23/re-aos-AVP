     <string name="metadata_edit_unavailable">Najpierw zescrapuj ten film, aby edytować informacje</string>
     <string name="player_stop">Zatrzymaj</string>
+    <string name="preferences_brightness_gesture">Gest jasności</string>
+    <string name="preferences_brightness_gesture_summary">Przesuwanie w górę/dół przy lewej krawędzi playera zmienia jasność tylko dla bieżącego filmu</string>
 </resources>
diff --git a/res/values/strings.xml b/res/values/strings.xml
index ab2e91c..fdee84f 100644
--- a/res/values/strings.xml
+++ b/res/values/strings.xml
@@ -1102,4 +1102,6 @@
     <string name="metadata_edit_invalid">Check the highlighted fields</string>
     <string name="metadata_edit_unavailable">Scrape this video first to edit its info</string>
     <string name="player_stop">Stop</string>
+    <string name="preferences_brightness_gesture">Brightness swipe</string>
+    <string name="preferences_brightness_gesture_summary">Swipe up/down on the left edge of the player to change brightness for the current video only</string>
 </resources>
diff --git a/res/xml/preferences_video.xml b/res/xml/preferences_video.xml
index 756774e..66c4607 100644
--- a/res/xml/preferences_video.xml
