                 @Override
                 public boolean onKey(View v, int keyCode, KeyEvent event) {
@@ -2088,10 +2095,12 @@ public class PlayerController implements View.OnTouchListener, OnGenericMotionLi
         }
 
         if (Math.abs(scrollGestureVertical) > SCROLL_THRESHOLD && isVerticalScroll) {
-            if (e1.getX() < halfWidth) { // left screen part
+            if (e1.getX() < screenWidth * BRIGHTNESS_EDGE_RATIO
