From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: oop23 <ilidans01yt@gmail.com>
Date: Sat, 10 Oct 2026 04:41:46 +0000
Subject: [PATCH] Player: no brightness button, brightness swipe opt-in,
 readable OSD

- The brightness button leaves the player bar.
- Brightness swipe is off by default; when enabled in settings it only
  works on a narrow left edge, so it never fights with seeking.
- Times and OSD texts get a soft shadow, OSD bubbles a darker rounded
  background, readable over bright scenes.
---
 res/drawable/rounded_rectangle.xml            |  6 ++++--
 res/values-pl/strings.xml                     |  2 ++
 res/values/strings.xml                        |  2 ++
 res/xml/preferences_video.xml                 |  7 +++++++
 .../video/player/PlayerActivity.java          |  5 +----
 .../video/player/PlayerController.java        | 20 +++++++++++++++++--
 6 files changed, 34 insertions(+), 8 deletions(-)

diff --git a/res/drawable/rounded_rectangle.xml b/res/drawable/rounded_rectangle.xml
index e19ceac..65e0cab 100644
--- a/res/drawable/rounded_rectangle.xml
+++ b/res/drawable/rounded_rectangle.xml
@@ -1,4 +1,6 @@
+<!-- ReNova: OSD bubbles (volume, seek preview...) readable over any picture -->
 <shape xmlns:android="http://schemas.android.com/apk/res/android">
-    <solid android:color="#40000000"/>
-    <corners android:radius="12dp"/>
+    <solid android:color="#B307061A"/>
+    <stroke android:width="1dp" android:color="#33FFFFFF"/>
+    <corners android:radius="16dp"/>
 </shape>
diff --git a/res/values-pl/strings.xml b/res/values-pl/strings.xml
