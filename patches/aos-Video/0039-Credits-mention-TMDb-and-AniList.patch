     <string name="data_source_nfo">NFO</string>
diff --git a/res/values/strings.xml b/res/values/strings.xml
index b396244..4e7fd3f 100644
--- a/res/values/strings.xml
+++ b/res/values/strings.xml
@@ -1107,7 +1107,7 @@
     <string name="player_buffering_percent">Buffering %1$d%%</string>
     <string name="renova_about_summary">Safe video player for network shares: your sources are read-only. Tap to open the project page.</string>
     <string name="renova_credits_title">Built on NOVA Video Player</string>
