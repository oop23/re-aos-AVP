 res/values-pl/strings.xml | 2 +-
 res/values/strings.xml    | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/res/values-pl/strings.xml b/res/values-pl/strings.xml
index b71cdc5..6af632f 100644
--- a/res/values-pl/strings.xml
+++ b/res/values-pl/strings.xml
@@ -1012,7 +1012,7 @@
     <string name="player_buffering_percent">Buforowanie %1$d%%</string>
     <string name="renova_about_summary">Bezpieczny odtwarzacz wideo dla udziałów sieciowych: Twoje źródła są tylko do odczytu. Stuknij, aby otworzyć stronę projektu.</string>
     <string name="renova_credits_title">Zbudowany na NOVA Video Player</string>
-    <string name="renova_credits_summary">Podziękowania dla zespołu NOVA i Archos Video Player Community Edition. ReNova to niezależny fork.</string>
