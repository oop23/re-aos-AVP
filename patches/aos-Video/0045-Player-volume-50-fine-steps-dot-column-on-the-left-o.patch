+    // ReNova: 50 volume steps instead of the 15 of the system: the system volume goes to the step
+    // just above, the player attenuates the rest
+    public static final int FINE_VOLUME_STEPS = 50;
+    private int mFineVolume = -1;
+    private int mFineVolumeSystemIndex = -1;
+
+    /** Volume up/down by a fine step (2 %), shows the dot column. */
+    public void adjustVolume(int steps) {
+        if (mAudioManager == null) return;
+        int max = mAudioManager.getStreamMaxVolume(AudioManager.STREAM_MUSIC);
+        int index = mAudioManager.getStreamVolume(AudioManager.STREAM_MUSIC);
+        if (mFineVolume < 0 || index != mFineVolumeSystemIndex) {
+            // first use, or changed outside the player (system panel): start from the system level
+            mFineVolume = max > 0 ? Math.round(index * FINE_VOLUME_STEPS / (float) max) : 0;
+        }
+        mFineVolume = Math.max(0, Math.min(FINE_VOLUME_STEPS, mFineVolume + steps));
+        int newIndex = max > 0 ? (int) Math.ceil(mFineVolume * max / (float) FINE_VOLUME_STEPS) : 0;
+        float gain = newIndex == 0 ? 0f
+                : (mFineVolume / (float) FINE_VOLUME_STEPS) / (newIndex / (float) max);
+        setMusicVolume(newIndex);
+        mFineVolumeSystemIndex = newIndex;
+        if (Player.sPlayer != null) Player.sPlayer.setSoftwareVolume(gain);
+        if (mVolumeDots == null && mPlayerView != null) mVolumeDots = mPlayerView.findViewById(R.id.volume_dots);
+        if (mVolumeDots != null) mVolumeDots.show(mFineVolume / (float) FINE_VOLUME_STEPS);
     }
 
