+package com.archos.mediacenter.video.player;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.graphics.RectF;
+import android.util.AttributeSet;
+import android.view.View;
+
+import java.util.Locale;
+
+/**
+ * Volume shown while it changes: a column of dots on the left of the player, filled from the
+ * bottom, with the percentage below. Replaces the side volume bar that took room from the video.
+ */
+public class VolumeDotsView extends View {
+
+    private static final int DOTS = 20;
+    private static final long HIDE_AFTER_MS = 1200;
+
+    private final Paint mOn = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mOff = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mText = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mBubble = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final RectF mRect = new RectF();
+    private float mLevel; // 0..1
+
+    private final Runnable mHide = () -> animate().alpha(0f).setDuration(250)
+            .withEndAction(() -> setVisibility(GONE)).start();
+
+    public VolumeDotsView(Context context) {
+        this(context, null);
+    }
+
+    public VolumeDotsView(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        float density = getResources().getDisplayMetrics().density;
+        mOn.setColor(0xFFFFD27A);
+        mOn.setShadowLayer(4 * density, 0, 0, 0x99FFD27A);
+        mOff.setColor(0x59FFFFFF);
+        mText.setColor(0xFFFFFFFF);
+        mText.setTextAlign(Paint.Align.CENTER);
+        mText.setTextSize(13 * density);
+        mText.setFakeBoldText(true);
+        mText.setShadowLayer(4 * density, 0, 1 * density, 0xCC000000);
+        mBubble.setColor(0x9907061A);
+        setLayerType(LAYER_TYPE_SOFTWARE, null); // shadow layers on the dots
+    }
+
+    /** Shows the level (0..1) for a moment. */
+    public void show(float level) {
+        mLevel = Math.max(0f, Math.min(1f, level));
+        removeCallbacks(mHide);
+        animate().cancel();
+        setAlpha(1f);
+        setVisibility(VISIBLE);
+        invalidate();
+        postDelayed(mHide, HIDE_AFTER_MS);
+    }
+
+    @Override
+    protected void onDraw(Canvas canvas) {
+        float density = getResources().getDisplayMetrics().density;
+        float w = getWidth(), h = getHeight();
+        float textSpace = 24 * density;
+        mRect.set(0, 0, w, h);
+        canvas.drawRoundRect(mRect, w / 2, w / 2, mBubble);
+        float top = w / 2, bottom = h - textSpace - w / 4;
+        float step = (bottom - top) / (DOTS - 1);
+        float radius = Math.min(w * 0.16f, step * 0.32f);
+        int lit = Math.round(mLevel * DOTS);
+        for (int i = 0; i < DOTS; i++) {
+            float cy = bottom - i * step;
+            canvas.drawCircle(w / 2, cy, radius, i < lit ? mOn : mOff);
+        }
+        String percent = String.format(Locale.ROOT, "%d%%", Math.round(mLevel * 100));
+        canvas.drawText(percent, w / 2, h - textSpace / 2 + mText.getTextSize() / 3, mText);
+    }
+}
