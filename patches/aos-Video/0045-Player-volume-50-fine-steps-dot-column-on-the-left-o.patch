     /* IMediaPlayer.Listener */
+    // ReNova: fine volume steps between two system volume steps, see PlayerController
+    private static float sSoftwareGain = 1f;
+
+    public void setSoftwareVolume(float gain) {
+        sSoftwareGain = Math.max(0f, Math.min(1f, gain));
+        if (mMediaPlayer != null) {
+            try {
+                mMediaPlayer.setVolume(sSoftwareGain, sSoftwareGain);
+            } catch (IllegalStateException ignored) {
+                // not ready yet: applied when prepared
+            }
+        }
+    }
+
     public void onPrepared(IMediaPlayer mp) {
         if (mPlaybackEnding || mp != mMediaPlayer) return;
         mCurrentState = STATE_PREPARED;
+        if (sSoftwareGain < 1f) {
+            try {
+                mMediaPlayer.setVolume(sSoftwareGain, sSoftwareGain);
+            } catch (IllegalStateException ignored) {
+            }
+        }
         if (mSurfaceController != null)
             mSurfaceController.setMediaPlayer(mMediaPlayer);
 
