+package com.archos.filecorelibrary;
+
+import android.content.Context;
+import android.net.Uri;
+
+import com.archos.environment.ArchosUtils;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import java.io.File;
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.CopyOnWriteArrayList;
+
+/**
+ * Media sources are read-only, the same way Kodi treats them.
+ *
+ * The player never deletes, renames, moves or writes anything on SMB/FTP/SFTP/WebDAV/UPnP shares,
+ * SAF documents or the user's local media folders. The only places the app may write to through a
+ * {@link FileEditor} are its own private directories (internal files/cache, external app-specific
+ * files/cache). Everything else is refused at the FileEditor level, whatever UI path asked for it.
+ */
+public final class SourceAccessPolicy {
+
+    private static final Logger log = LoggerFactory.getLogger(SourceAccessPolicy.class);
+
+    private static final List<String> sExtraWritableRoots = new CopyOnWriteArrayList<>();
+
+    private SourceAccessPolicy() {}
+
+    /**
+     * @return true only if uri points inside one of the app private directories.
+     */
+    public static boolean isWritable(Uri uri) {
+        if (uri == null) return false;
+        String scheme = uri.getScheme();
+        if (scheme != null && !"file".equalsIgnoreCase(scheme)) return false;
+        String path = uri.getPath();
+        if (path == null || path.isEmpty()) return false;
+        String canonical = canonicalize(path);
+        for (String root : getWritableRoots()) {
+            if (isUnder(canonical, root)) return true;
+        }
+        return false;
+    }
+
+    /**
+     * Throws if uri is not writable. Use at the top of any mutating FileEditor operation that
+     * is allowed to throw.
+     */
+    public static void enforceWritable(Uri uri, String operation) throws ReadOnlySourceException {
+        if (!isWritable(uri)) {
+            log.warn("blocked {} on read-only source {}", operation, uri);
+            throw new ReadOnlySourceException(operation, uri);
+        }
+    }
+
+    /**
+     * Boolean flavour for mutating FileEditor operations that report failure by returning false.
+     */
+    public static boolean allow(Uri uri, String operation) {
+        if (isWritable(uri)) return true;
+        log.warn("blocked {} on read-only source {}", operation, uri);
+        return false;
+    }
+
+    /**
+     * Registers an additional app owned directory as writable (e.g. a dedicated export folder).
+     * Never register a directory that can contain user media.
+     */
+    public static void registerWritableRoot(File dir) {
+        if (dir == null) return;
+        String root = canonicalize(dir.getAbsolutePath());
+        if (!sExtraWritableRoots.contains(root)) sExtraWritableRoots.add(root);
+    }
+
+    static List<String> getWritableRoots() {
+        List<String> roots = new ArrayList<>(sExtraWritableRoots);
+        Context context = ArchosUtils.getGlobalContext();
+        if (context != null) {
+            addRoot(roots, context.getFilesDir());
+            addRoot(roots, context.getCacheDir());
+            addRoot(roots, context.getNoBackupFilesDir());
+            File dbDir = context.getDatabasePath("x").getParentFile();
+            addRoot(roots, dbDir);
+            File[] externalFiles = context.getExternalFilesDirs(null);
+            if (externalFiles != null) for (File f : externalFiles) addRoot(roots, f);
+            File[] externalCaches = context.getExternalCacheDirs();
+            if (externalCaches != null) for (File f : externalCaches) addRoot(roots, f);
+        }
+        return roots;
+    }
+
+    private static void addRoot(List<String> roots, File dir) {
+        if (dir == null) return;
+        roots.add(canonicalize(dir.getAbsolutePath()));
+    }
+
+    static boolean isUnder(String path, String root) {
+        if (root == null || root.isEmpty()) return false;
+        String r = root.endsWith("/") ? root.substring(0, root.length() - 1) : root;
+        return path.equals(r) || path.startsWith(r + "/");
+    }
+
+    static String canonicalize(String path) {
+        try {
+            return new File(path).getCanonicalPath();
+        } catch (IOException e) {
+            // never let ".." trick the prefix check
+            return new File(path).toURI().normalize().getPath();
+        }
+    }
+}
