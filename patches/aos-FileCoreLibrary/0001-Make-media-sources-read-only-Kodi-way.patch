+// limitations under the License.
+
+package com.archos.filecorelibrary;
+
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+import static org.junit.Assert.fail;
+
+import android.content.Context;
+import android.net.Uri;
+
+import androidx.test.core.app.ApplicationProvider;
+
+import com.archos.environment.ArchosUtils;
+import com.archos.filecorelibrary.ftp.FtpFileEditor;
+import com.archos.filecorelibrary.localstorage.LocalStorageFileEditor;
+import com.archos.filecorelibrary.smbj.SmbjFileEditor;
+
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.annotation.Config;
+
+import java.io.File;
+import java.io.OutputStream;
+
+@RunWith(RobolectricTestRunner.class)
+@Config(sdk = 28)
+public class SourceAccessPolicyTest {
+
+    private Context mContext;
+
+    @Before
+    public void setUp() {
+        mContext = ApplicationProvider.getApplicationContext();
+        ArchosUtils.setGlobalContext(mContext);
+    }
+
+    @Test
+    public void networkSourcesAreNeverWritable() {
+        assertFalse(SourceAccessPolicy.isWritable(Uri.parse("smb://nas/movies/a.mkv")));
+        assertFalse(SourceAccessPolicy.isWritable(Uri.parse("ftp://nas/movies/a.mkv")));
+        assertFalse(SourceAccessPolicy.isWritable(Uri.parse("sftp://nas/movies/a.mkv")));
+        assertFalse(SourceAccessPolicy.isWritable(Uri.parse("webdavs://nas/movies/a.mkv")));
+        assertFalse(SourceAccessPolicy.isWritable(Uri.parse("upnp://1.2.3.4/a.mkv")));
+        assertFalse(SourceAccessPolicy.isWritable(Uri.parse("content://media/external/video/media/12")));
+        assertFalse(SourceAccessPolicy.isWritable(null));
+    }
+
+    @Test
+    public void localMediaFoldersAreNotWritable() {
+        assertFalse(SourceAccessPolicy.isWritable(Uri.parse("file:///storage/emulated/0/Movies/a.mkv")));
+        assertFalse(SourceAccessPolicy.isWritable(Uri.parse("/storage/emulated/0/Download/a.mkv")));
+    }
+
+    @Test
+    public void appPrivateDirsAreWritable() {
+        assertTrue(SourceAccessPolicy.isWritable(Uri.fromFile(new File(mContext.getCacheDir(), "subtitles/a.srt"))));
+        assertTrue(SourceAccessPolicy.isWritable(Uri.fromFile(new File(mContext.getFilesDir(), "x"))));
+    }
+
+    @Test
+    public void pathTraversalOutOfPrivateDirIsRefused() {
+        File escaped = new File(mContext.getFilesDir(), "../../../../storage/emulated/0/Movies/a.mkv");
+        assertFalse(SourceAccessPolicy.isWritable(Uri.fromFile(escaped)));
+    }
+
+    @Test
+    public void siblingPrefixIsNotConfusedWithRoot() {
+        String files = mContext.getFilesDir().getAbsolutePath();
+        assertFalse(SourceAccessPolicy.isWritable(Uri.parse("file://" + files + "_evil/a.mkv")));
+    }
+
+    @Test
+    public void networkEditorsRefuseMutations() throws Exception {
+        FileEditor[] editors = {
+                new SmbjFileEditor(Uri.parse("smb://nas/movies/a.mkv")),
+                new FtpFileEditor(Uri.parse("ftp://nas/movies/a.mkv")),
+        };
+        for (FileEditor editor : editors) {
+            try {
+                editor.delete();
+                fail("delete must be refused for " + editor.getUri());
+            } catch (ReadOnlySourceException expected) {
+            }
+            try {
+                editor.getOutputStream();
+                fail("write must be refused for " + editor.getUri());
+            } catch (ReadOnlySourceException expected) {
+            }
+            assertFalse(editor.rename("b.mkv"));
+            assertFalse(editor.move(Uri.parse("smb://nas/movies/b.mkv")));
+            assertFalse(editor.mkdir());
+        }
+    }
+
+    @Test
+    public void localEditorProtectsMediaButAllowsPrivateCache() throws Exception {
+        File media = File.createTempFile("movie", ".mkv");
+        try {
+            LocalStorageFileEditor editor = new LocalStorageFileEditor(Uri.fromFile(media), mContext);
+            try {
+                editor.delete();
+                fail("delete must be refused outside app private dirs");
+            } catch (ReadOnlySourceException expected) {
+            }
+            assertTrue(media.exists());
+            assertFalse(editor.rename("renamed.mkv"));
+            assertTrue(media.exists());
+        } finally {
+            media.delete();
+        }
+
+        File cached = new File(mContext.getCacheDir(), "subtitles/test.srt");
+        cached.getParentFile().mkdirs();
+        LocalStorageFileEditor cacheEditor = new LocalStorageFileEditor(Uri.fromFile(cached), mContext);
+        try (OutputStream os = cacheEditor.getOutputStream()) {
+            os.write('x');
+        }
+        assertTrue(cached.exists());
+        cacheEditor.delete();
+        assertFalse(cached.exists());
+    }
+}
