+package com.archos.filecorelibrary;
+
+import android.net.Uri;
+
+import java.io.FileNotFoundException;
+
+/**
+ * Thrown when something tries to modify a media source (network share, local media folder,
+ * SAF document...). Media sources are strictly read-only, see {@link SourceAccessPolicy}.
+ *
+ * Extends FileNotFoundException on purpose: it is what java.io reports for EACCES, so every
+ * existing caller that already falls back on FileNotFoundException/IOException (e.g. subtitles
+ * download falling back to the private cache) keeps working without changes.
+ */
+public class ReadOnlySourceException extends FileNotFoundException {
+    public ReadOnlySourceException(String operation, Uri uri) {
+        super("read-only source, refusing " + operation + " on " + uri);
+    }
+}
diff --git a/src/com/archos/filecorelibrary/SourceAccessPolicy.java b/src/com/archos/filecorelibrary/SourceAccessPolicy.java
new file mode 100644
index 0000000..3ef8dbb
--- /dev/null
+++ b/src/com/archos/filecorelibrary/SourceAccessPolicy.java
@@ -0,0 +1,127 @@
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//      http://www.apache.org/licenses/LICENSE-2.0
