+package com.archos.mediascraper.themoviedb3;
+
+import static org.junit.Assert.assertArrayEquals;
+import static org.junit.Assert.assertNull;
+
+import org.junit.Test;
+
+import java.util.Arrays;
+import java.util.List;
+
+public class AbsoluteEpisodesTest {
+
+    private static final List<AbsoluteEpisodes.Season> SHOW = Arrays.asList(
+            new AbsoluteEpisodes.Season(0, 12),  // specials do not count
+            new AbsoluteEpisodes.Season(2, 30),
+            new AbsoluteEpisodes.Season(1, 61),
+            new AbsoluteEpisodes.Season(3, 40));
+
+    @Test
+    public void numberInsideFirstSeasonIsKept() {
+        assertNull(AbsoluteEpisodes.map(SHOW, 5));
+        assertNull(AbsoluteEpisodes.map(SHOW, 61));
+    }
+
+    @Test
+    public void numberPastFirstSeasonMovesToItsSeason() {
+        assertArrayEquals(new int[] { 2, 1 }, AbsoluteEpisodes.map(SHOW, 62));
+        assertArrayEquals(new int[] { 2, 30 }, AbsoluteEpisodes.map(SHOW, 91));
+        assertArrayEquals(new int[] { 3, 9 }, AbsoluteEpisodes.map(SHOW, 100));
+    }
+
+    @Test
+    public void numberPastTheLastSeasonIsNotGuessed() {
+        assertNull(AbsoluteEpisodes.map(SHOW, 500));
+    }
+}
