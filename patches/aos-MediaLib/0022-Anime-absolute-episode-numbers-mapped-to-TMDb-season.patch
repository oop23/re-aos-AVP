+package com.archos.mediascraper.themoviedb3;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+/**
+ * Anime dumps number episodes from the start of the show ("One Piece - 1050"), TMDb splits the
+ * same show into seasons (One Piece S21E59). Maps the absolute number to TMDb's season and
+ * episode by walking the episode counts of the regular seasons.
+ *
+ * Pure Java (no Android types) so it is unit testable on the JVM.
+ */
+public final class AbsoluteEpisodes {
+
+    private AbsoluteEpisodes() {}
+
+    /** A regular season of the show: its number and how many episodes TMDb lists in it. */
+    public static final class Season implements Comparable<Season> {
+        final int number;
+        final int episodeCount;
+
+        public Season(int number, int episodeCount) {
+            this.number = number;
+            this.episodeCount = episodeCount;
+        }
+
+        @Override
+        public int compareTo(Season other) {
+            return Integer.compare(number, other.number);
+        }
+    }
+
+    /**
+     * @return {season, episode} for an absolute episode number past the first season, or null when
+     * the number fits in the first season (nothing to remap) or goes past the last one
+     */
+    public static int[] map(List<Season> seasons, int absoluteEpisode) {
+        if (seasons == null || absoluteEpisode <= 0) return null;
+        List<Season> regular = new ArrayList<>();
+        for (Season s : seasons) {
+            if (s != null && s.number > 0 && s.episodeCount > 0) regular.add(s);
+        }
+        if (regular.size() < 2) return null;
+        Collections.sort(regular);
+        if (absoluteEpisode <= regular.get(0).episodeCount) return null;
+        int remaining = absoluteEpisode;
+        for (Season s : regular) {
+            if (remaining <= s.episodeCount) return new int[] { s.number, remaining };
+            remaining -= s.episodeCount;
+        }
+        return null;
+    }
+}
diff --git a/src/com/archos/mediascraper/xml/ShowScraper4.java b/src/com/archos/mediascraper/xml/ShowScraper4.java
index afee9ce..58d6eec 100644
--- a/src/com/archos/mediascraper/xml/ShowScraper4.java
+++ b/src/com/archos/mediascraper/xml/ShowScraper4.java
@@ -40,6 +40,7 @@ import com.archos.mediascraper.ShowUtils;
 import com.archos.mediascraper.preprocess.SearchInfo;
 import com.archos.mediascraper.preprocess.TvShowSearchInfo;
 import com.archos.filecorelibrary.FileUtils;
+import com.archos.mediascraper.themoviedb3.AbsoluteEpisodes;
 import com.archos.mediascraper.themoviedb3.MyTmdb;
 import com.archos.mediascraper.themoviedb3.SearchShow;
 import com.archos.mediascraper.themoviedb3.SearchShowResult;
@@ -360,6 +361,29 @@ public class ShowScraper4 extends BaseScraper2 {
             }
         }
 
+        // ReNova: anime dumps number episodes from the start of the show ("One Piece - 1050" is
+        // read as S1E1050) while TMDb splits it into seasons: map the absolute number to TMDb's
+        // season/episode from the episode counts of its seasons (show info is cached per show)
+        if (requestedSeason == 1 && requestedEpisode > 10 && season <= 1) {
+            String absShowKey = ShowUtils.cleanUpName(result.getOriginalTitle().toLowerCase()) + "|" + showId + "|" + resultLanguage;
+            ShowIdTvSearchResult showInfo = ShowIdTvSearch.getTvShowResponse(absShowKey + requestCacheSuffix, showId, resultLanguage, adultScrape, requestTmdb);
+            if (showInfo != null && showInfo.status == ScrapeStatus.OKAY && showInfo.tvShow != null && showInfo.tvShow.seasons != null) {
+                List<AbsoluteEpisodes.Season> seasonCounts = new ArrayList<>();
+                for (TvSeason tvSeason : showInfo.tvShow.seasons) {
+                    if (tvSeason != null && tvSeason.season_number != null && tvSeason.episode_count != null)
+                        seasonCounts.add(new AbsoluteEpisodes.Season(tvSeason.season_number, tvSeason.episode_count));
+                }
+                int[] mapped = AbsoluteEpisodes.map(seasonCounts, requestedEpisode);
+                if (mapped != null) {
+                    log.info("getDetailsInternal: absolute episode {} of show {} is s{}e{}", requestedEpisode, showId, mapped[0], mapped[1]);
+                    requestedSeason = mapped[0];
+                    requestedEpisode = mapped[1];
+                    season = mapped[0];
+                    episode = mapped[1];
+                }
+            }
+        }
+
         // Use OPTIONS values if available (for re-scraping), otherwise use SearchResult extras (for manual scraping)
         // Manual scraping doesn't set season/episode in OPTIONS but has them in SearchResult.extras
         // Re-scraping sets season in OPTIONS but may not have SearchResult.extras populated
