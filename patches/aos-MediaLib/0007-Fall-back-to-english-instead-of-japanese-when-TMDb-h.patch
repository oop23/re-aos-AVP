+package com.archos.mediascraper.themoviedb3;
+
+import static org.junit.Assert.assertEquals;
+
+import com.uwetrottmann.tmdb2.entities.Translations;
+import com.uwetrottmann.tmdb2.entities.Translations.Translation;
+import com.uwetrottmann.tmdb2.entities.Translations.Translation.Data;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.annotation.Config;
+
+import java.util.ArrayList;
+
+@RunWith(RobolectricTestRunner.class)
+@Config(manifest = Config.NONE, sdk = 33)
+public class TmdbTextFallbackTest {
+
+    private static Translations translations(String[]... entries) {
+        Translations t = new Translations();
+        t.translations = new ArrayList<>();
+        for (String[] e : entries) {
+            Translation tr = new Translation();
+            tr.iso_639_1 = e[0];
+            tr.data = new Data();
+            tr.data.name = e[1];
+            tr.data.title = e[1];
+            tr.data.overview = e[2];
+            t.translations.add(tr);
+        }
+        return t;
+    }
+
+    private static final Translations FRIEREN = translations(
+            new String[] { "ja", "葬送のフリーレン", "魔王を倒した勇者一行の後日譚" },
+            new String[] { "en", "Frieren: Beyond Journey's End", "After the party of heroes defeated the Demon King..." });
+
+    @Test
+    public void untranslatedAnimeFallsBackToEnglish() {
+        assertEquals("Frieren: Beyond Journey's End", TmdbTextFallback.title("葬送のフリーレン", "pl", FRIEREN, true));
+        assertEquals("After the party of heroes defeated the Demon King...", TmdbTextFallback.overview("", "pl", FRIEREN));
+        assertEquals("After the party of heroes defeated the Demon King...", TmdbTextFallback.overview(null, "pl", FRIEREN));
+    }
+
+    @Test
+    public void polishTranslationIsKept() {
+        Translations t = translations(
+                new String[] { "pl", "Frieren: Pochowana w podróży", "Polski opis" },
+                new String[] { "en", "Frieren: Beyond Journey's End", "English plot" });
+        assertEquals("Frieren: Pochowana w podróży", TmdbTextFallback.title("Frieren: Pochowana w podróży", "pl", t, true));
+        assertEquals("Polski opis", TmdbTextFallback.overview("Polski opis", "pl", t));
+    }
+
+    @Test
+    public void japaneseUserKeepsJapanese() {
+        assertEquals("葬送のフリーレン", TmdbTextFallback.title("葬送のフリーレン", "ja", FRIEREN, true));
+    }
+
+    @Test
+    public void noEnglishTranslationKeepsWhatWeHave() {
+        Translations onlyJa = translations(new String[] { "ja", "葬送のフリーレン", "あらすじ" });
+        assertEquals("葬送のフリーレン", TmdbTextFallback.title("葬送のフリーレン", "pl", onlyJa, true));
+    }
+}
