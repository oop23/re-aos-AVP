+++ b/src/com/archos/mediascraper/themoviedb3/ShowIdParser.java
@@ -45,15 +45,18 @@ public class ShowIdParser {
         mContext = context;
         ShowTags result = new ShowTags();
 
-        if (serie.overview != null) {
-            if (log.isDebugEnabled()) log.debug("getResult: {} overview/plot {}", serie.name, serie.overview);
-            result.setPlot(serie.overview);
+        // no polish (or other) translation: TMDb answers with the original japanese/korean text
+        String overview = TmdbTextFallback.overview(serie.overview, requestedLanguage, serie.translations);
+        if (overview != null) {
+            if (log.isDebugEnabled()) log.debug("getResult: {} overview/plot {}", serie.name, overview);
+            result.setPlot(overview);
         } else {
             log.warn("getResult: {} has no overview/plot", serie.name);
         }
 
         result.setRating(Math.round(serie.vote_average.floatValue() * 10)/10.0f);
-        result.setTitle(serie.name + (( year != null) ? " " + year : ""));
+        String name = TmdbTextFallback.title(serie.name, requestedLanguage, serie.translations, true);
+        result.setTitle(name + (( year != null) ? " " + year : ""));
         if (log.isDebugEnabled()) {
             log.debug("getResult: TMDb show id={} name={} original_language={} original_name={} spoken_languages={}",
                     serie.id, serie.name, serie.original_language, serie.original_name,
@@ -61,7 +64,7 @@ public class ShowIdParser {
         }
         result.setOriginalLanguage(serie.original_language);
         result.setOriginalTitle(serie.original_name);
-        result.setTitleLanguage(TmdbTitleLanguage.forShow(serie.name, requestedLanguage,
+        result.setTitleLanguage(TmdbTitleLanguage.forShow(name, requestedLanguage,
                 serie.original_name, serie.original_language, serie.translations));
         if (serie.spoken_languages != null) {
             List<String> spokenLanguages = new ArrayList<String>();
diff --git a/src/com/archos/mediascraper/themoviedb3/TmdbTextFallback.java b/src/com/archos/mediascraper/themoviedb3/TmdbTextFallback.java
new file mode 100644
index 0000000..2c8687c
--- /dev/null
+++ b/src/com/archos/mediascraper/themoviedb3/TmdbTextFallback.java
@@ -0,0 +1,86 @@
