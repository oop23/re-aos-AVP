+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package com.archos.mediascraper.themoviedb3;
+
+import com.archos.mediacenter.utils.ISO639codes;
+import com.uwetrottmann.tmdb2.entities.Translations;
+import com.uwetrottmann.tmdb2.entities.Translations.Translation;
+
+/**
+ * When TMDb has no translation in the user's language it returns the original title and an empty
+ * overview: anime then show up as 葬送のフリーレン with no plot. Fall back to the english
+ * translation (already part of the response) whenever the text would otherwise be missing or in a
+ * script the user did not ask for.
+ */
+final class TmdbTextFallback {
+
+    private TmdbTextFallback() {}
+
+    static String title(String value, String requestedLanguage, Translations translations, boolean show) {
+        if (!isEmpty(value) && !needsFallback(value, requestedLanguage)) return value;
+        String english = translated(translations, "en", show, false);
+        return !isEmpty(english) ? english : value;
+    }
+
+    static String overview(String value, String requestedLanguage, Translations translations) {
+        if (!isEmpty(value) && !needsFallback(value, requestedLanguage)) return value;
+        String requested = translated(translations, normalize(requestedLanguage), false, true);
+        if (!isEmpty(requested) && !needsFallback(requested, requestedLanguage)) return requested;
+        String english = translated(translations, "en", false, true);
+        return !isEmpty(english) ? english : value;
+    }
+
+    /** text mostly written in a non latin script while the user asked for a latin script language */
+    static boolean needsFallback(String text, String requestedLanguage) {
+        if (isEmpty(text)) return true;
+        String lang = normalize(requestedLanguage);
+        if (NON_LATIN_LANGUAGES.contains(lang)) return false;
+        int letters = 0, nonLatin = 0;
+        for (int i = 0; i < text.length(); ) {
+            int cp = text.codePointAt(i);
+            i += Character.charCount(cp);
+            if (!Character.isLetter(cp)) continue;
+            letters++;
+            if (!isLatinLetter(cp)) nonLatin++;
+        }
+        return letters > 0 && nonLatin * 2 > letters;
+    }
+
+    private static final java.util.Set<String> NON_LATIN_LANGUAGES = new java.util.HashSet<>(java.util.Arrays.asList(
+            "ja", "zh", "ko", "ru", "uk", "be", "bg", "sr", "mk", "el", "he", "ar", "fa", "hi", "th", "ka", "hy"));
+    // Character.UnicodeScript needs API 24, minSdk is 23
+    static boolean isLatinLetter(int cp) {
+        return cp < 0x250 || (cp >= 0x1E00 && cp <= 0x1EFF) || (cp >= 0x2C60 && cp <= 0x2C7F)
+                || (cp >= 0xA720 && cp <= 0xA7FF) || (cp >= 0xFF21 && cp <= 0xFF5A);
+    }
+
+
+    private static String translated(Translations translations, String language, boolean show, boolean overview) {
+        if (translations == null || translations.translations == null) return null;
+        for (Translation t : translations.translations) {
+            if (t == null || t.data == null || !language.equals(normalize(t.iso_639_1))) continue;
+            String v = overview ? t.data.overview : (show ? t.data.name : t.data.title);
+            if (!isEmpty(v)) return v;
+        }
+        return null;
+    }
+
+    private static String normalize(String language) {
+        String code = language == null ? "" : ISO639codes.getISO6391ForLetterCode(language);
+        return code.isEmpty() ? "und" : code;
+    }
+
+    private static boolean isEmpty(String s) {
+        return s == null || s.trim().isEmpty();
+    }
+}
