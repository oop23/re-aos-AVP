From: oop23 <ilidans01yt@gmail.com>
Date: Sat, 10 Oct 2026 04:12:48 +0000
Subject: [PATCH] Fall back to english instead of japanese when TMDb has no
 translation
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Without a translation in the user's language TMDb returns the original
title and an empty overview, so anime showed up as 葬送のフリーレン with
no plot. Show and movie titles/plots now fall back to the english
translation already present in the response whenever the text would be
missing or in a non latin script the user did not ask for.
---
 .../themoviedb3/MovieIdParser2.java           |  7 +-
 .../themoviedb3/ShowIdParser.java             | 13 +--
 .../themoviedb3/TmdbTextFallback.java         | 86 +++++++++++++++++++
 .../themoviedb3/TmdbTextFallbackTest.java     | 77 +++++++++++++++++
 4 files changed, 175 insertions(+), 8 deletions(-)
 create mode 100644 src/com/archos/mediascraper/themoviedb3/TmdbTextFallback.java
 create mode 100644 test/java/com/archos/mediascraper/themoviedb3/TmdbTextFallbackTest.java

diff --git a/src/com/archos/mediascraper/themoviedb3/MovieIdParser2.java b/src/com/archos/mediascraper/themoviedb3/MovieIdParser2.java
index fb25071..1e2f8a3 100644
--- a/src/com/archos/mediascraper/themoviedb3/MovieIdParser2.java
+++ b/src/com/archos/mediascraper/themoviedb3/MovieIdParser2.java
@@ -71,7 +71,7 @@ public class MovieIdParser2 {
         if (movie.id != null) result.setOnlineId(movie.id);
         result.setOriginalLanguage(movie.original_language);
         result.setOriginalTitle(movie.original_title);
-        result.setTitleLanguage(TmdbTitleLanguage.forMovie(movie.title, requestedLanguage,
+        result.setTitleLanguage(TmdbTitleLanguage.forMovie(TmdbTextFallback.title(movie.title, requestedLanguage, movie.translations, false), requestedLanguage,
                 movie.original_title, movie.original_language, movie.translations));
         if (movie.spoken_languages != null) {
             List<String> spokenLanguages = new ArrayList<String>();
@@ -91,7 +91,8 @@ public class MovieIdParser2 {
                 result.addGenreIfAbsent(genre);
         }
         if (movie.imdb_id != null) result.setImdbId(movie.imdb_id);
-        if (movie.overview != null) result.setPlot(movie.overview);
+        String overview = TmdbTextFallback.overview(movie.overview, requestedLanguage, movie.translations);
+        if (overview != null) result.setPlot(overview);
         if (movie.production_companies != null)
             for (BaseCompany productionCompany: movie.production_companies)
                 result.addStudioIfAbsent(productionCompany.name);
@@ -116,7 +117,7 @@ public class MovieIdParser2 {
             if (log.isDebugEnabled()) log.debug("getResult collection overview: {}", movie.belongs_to_collection.overview);
         } else
             result.setCollectionId(-1);
-        if (movie.title != null) result.setTitle(movie.title);
+        if (movie.title != null) result.setTitle(TmdbTextFallback.title(movie.title, requestedLanguage, movie.translations, false));
         if (movie.vote_average != null)
             result.setRating(Math.round(movie.vote_average.floatValue() * 10)/10.0f);
 
diff --git a/src/com/archos/mediascraper/themoviedb3/ShowIdParser.java b/src/com/archos/mediascraper/themoviedb3/ShowIdParser.java
index d3114cc..649e7e7 100644
