+package com.archos.mediacenter.utils;
+
+import java.util.regex.Pattern;
+
+/**
+ * Container language tags of audio tracks are often wrong: a polish voice-over ("lektor") or dub
+ * muxed into an mkv very frequently keeps the "eng" (or "und") tag of the source. The track title
+ * and the release name usually tell the truth, so they win over the tag.
+ *
+ * Pure Java (no Android types) so it is unit testable on the JVM.
+ */
+public final class TrackLanguageHints {
+
+    private TrackLanguageHints() {}
+
+    private static final String B = "(?:^|[^\\p{L}])";  // start of word
+    private static final String E = "(?:$|[^\\p{L}])";  // end of word
+
+    private static final Object[][] TITLE_HINTS = {
+            // polish: lektor (voice-over) and dubbing are polish-specific words in practice
+            { "pol", Pattern.compile("(?i)" + B + "(?:lektor|polski|polska|polish|pl\\s*dub|dubbing\\s*pl|pl)" + E) },
+            { "rus", Pattern.compile("(?i)" + B + "(?:russian|rus|русский|многоголосый|дубляж)" + E) },
+            { "ukr", Pattern.compile("(?i)" + B + "(?:ukrainian|ukr|українська)" + E) },
+            { "ger", Pattern.compile("(?i)" + B + "(?:german|deutsch|ger)" + E) },
+            { "fre", Pattern.compile("(?i)" + B + "(?:french|français|francais|vff|vfq|vf|vf2)" + E) },
+            { "spa", Pattern.compile("(?i)" + B + "(?:spanish|español|espanol|castellano|latino)" + E) },
+            { "ita", Pattern.compile("(?i)" + B + "(?:italian|italiano|ita)" + E) },
+            { "por", Pattern.compile("(?i)" + B + "(?:portuguese|português|portugues|dublado)" + E) },
+            { "cze", Pattern.compile("(?i)" + B + "(?:czech|česky|cesky|čeština|cz)" + E) },
+            { "jpn", Pattern.compile("(?i)" + B + "(?:japanese|日本語|jpn|jap)" + E) },
+            { "kor", Pattern.compile("(?i)" + B + "(?:korean|한국어|kor)" + E) },
+            { "eng", Pattern.compile("(?i)" + B + "(?:english|eng)" + E) },
+    };
+
+    // release names: "Film.2020.PL.LEKTOR.1080p", "Film [Lektor PL]", "Film.PLDUB", "Film.DUBBING.PL"
+    private static final Pattern FILE_POLISH_AUDIO = Pattern.compile(
+            "(?i)" + B + "(?:lektor|pldub|dubbing|pl[\\s._-]*dub|dub[\\s._-]*pl|lektor[\\s._-]*pl|pl[\\s._-]*lektor)" + E);
+
+    /**
+     * @return the ISO 639-2 language a track title clearly names, or null
+     */
+    public static String fromTitle(String trackTitle) {
+        if (trackTitle == null || trackTitle.isEmpty()) return null;
+        for (Object[] hint : TITLE_HINTS) {
+            if (((Pattern) hint[1]).matcher(trackTitle).find()) return (String) hint[0];
+        }
+        return null;
+    }
+
+    /**
+     * Language of an audio track: what its title says when it says something, the container tag
+     * otherwise.
+     */
+    public static String effectiveLanguage(String trackTitle, String containerLanguage) {
+        String fromTitle = fromTitle(trackTitle);
+        return fromTitle != null ? fromTitle : containerLanguage;
+    }
+
+    /**
+     * @return "pol" when the release name says the audio is a polish voice-over or dub, else null
+     */
+    public static String fromFileName(String fileName) {
+        if (fileName == null || fileName.isEmpty()) return null;
+        return FILE_POLISH_AUDIO.matcher(fileName).find() ? "pol" : null;
+    }
+}
