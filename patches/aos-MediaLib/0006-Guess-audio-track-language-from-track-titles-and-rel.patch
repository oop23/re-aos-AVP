+package com.archos.mediacenter.utils;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNull;
+
+import org.junit.Test;
+
+public class TrackLanguageHintsTest {
+
+    @Test
+    public void trackTitleBeatsWrongContainerTag() {
+        assertEquals("pol", TrackLanguageHints.effectiveLanguage("Lektor PL", "eng"));
+        assertEquals("pol", TrackLanguageHints.effectiveLanguage("Polski - Lektor", "eng"));
+        assertEquals("pol", TrackLanguageHints.effectiveLanguage("Dubbing PL AC3", "und"));
+        assertEquals("ger", TrackLanguageHints.effectiveLanguage("Deutsch DTS", "eng"));
+        assertEquals("fre", TrackLanguageHints.effectiveLanguage("VFF", "eng"));
+        assertEquals("eng", TrackLanguageHints.effectiveLanguage("English", "pol"));
+    }
+
+    @Test
+    public void neutralTitlesKeepTheTag() {
+        assertEquals("eng", TrackLanguageHints.effectiveLanguage("AC3 5.1", "eng"));
+        assertEquals("eng", TrackLanguageHints.effectiveLanguage("Commentary", "eng"));
+        assertEquals("eng", TrackLanguageHints.effectiveLanguage("Plain", "eng"));
+        assertEquals("eng", TrackLanguageHints.effectiveLanguage(null, "eng"));
+    }
+
+    @Test
+    public void polishReleaseNames() {
+        assertEquals("pol", TrackLanguageHints.fromFileName("Film.2020.PL.LEKTOR.1080p.WEB-DL.mkv"));
+        assertEquals("pol", TrackLanguageHints.fromFileName("Film [Lektor PL].mkv"));
+        assertEquals("pol", TrackLanguageHints.fromFileName("Film.2020.PLDUB.mkv"));
+        assertEquals("pol", TrackLanguageHints.fromFileName("Film.2020.DUBBING.PL.mkv"));
+        assertNull(TrackLanguageHints.fromFileName("Film.2020.1080p.BluRay.x264.mkv"));
+        assertNull(TrackLanguageHints.fromFileName("Plektron.mkv"));
+        assertNull(TrackLanguageHints.fromFileName("Film.PL.SUBBED.mkv"));
+    }
+}
