+package com.archos.mediacenter.utils;
+
+import java.util.Locale;
+import java.util.regex.Pattern;
+
+/**
+ * A network share reached by IP ({@code smb://192.168.1.10/Video}) and by server name
+ * ({@code smb://TPLINK/Video}) is one folder: indexing both gave two copies of every video, each
+ * scraped on its own. This tells whether two folder uris are the same place, or one inside the
+ * other.
+ *
+ * Pure Java (no Android types) so it is unit testable on the JVM.
+ */
+public final class ShareEquivalence {
+
+    /** Server name to IP, as learnt by network discovery; may answer null. */
+    public interface Resolver {
+        String ipOf(String serverName);
+    }
+
+    private static final Pattern IPV4 = Pattern.compile("\\d{1,3}(?:\\.\\d{1,3}){3}");
+    private static final Pattern URI = Pattern.compile("^([a-zA-Z][a-zA-Z0-9+.-]*)://(?:[^@/]*@)?([^/:]*)(?::(\\d+))?(/.*)?$");
+
+    private ShareEquivalence() {}
+
+    /**
+     * @return "scheme://host[:port]/path/" with the host as an IP when known, lower case for SMB
+     * (case-insensitive file system), always ending with "/"; null when not a network uri
+     */
+    public static String canonical(String uri, Resolver resolver) {
+        if (uri == null) return null;
+        java.util.regex.Matcher m = URI.matcher(uri.trim());
+        if (!m.matches()) return null;
+        String scheme = m.group(1).toLowerCase(Locale.ROOT);
+        String host = m.group(2);
+        if (host == null || host.isEmpty()) return null;
+        if (!IPV4.matcher(host).matches() && resolver != null) {
+            String ip = resolver.ipOf(host);
+            if (ip != null && !ip.isEmpty()) host = ip;
+        }
+        host = host.toLowerCase(Locale.ROOT);
+        String port = m.group(3) != null ? ":" + m.group(3) : "";
+        String path = m.group(4) == null ? "/" : m.group(4);
+        if (!path.endsWith("/")) path = path + "/";
+        path = path.replaceAll("/{2,}", "/");
+        if ("smb".equals(scheme)) path = path.toLowerCase(Locale.ROOT);
+        return scheme + "://" + host + port + path;
+    }
+
+    /** Same folder, or one inside the other, once server names are resolved. */
+    public static boolean overlaps(String a, String b, Resolver resolver) {
+        String ca = canonical(a, resolver);
+        String cb = canonical(b, resolver);
+        if (ca == null || cb == null) return false;
+        return ca.startsWith(cb) || cb.startsWith(ca);
+    }
+
+    /** Same folder under two different spellings (IP vs name, case, trailing slash). */
+    public static boolean sameFolderOtherSpelling(String a, String b, Resolver resolver) {
+        if (a == null || b == null || a.equals(b)) return false;
+        String ca = canonical(a, resolver);
+        return ca != null && ca.equals(canonical(b, resolver));
+    }
+}
diff --git a/src/com/archos/mediacenter/utils/ShortcutDbAdapter.java b/src/com/archos/mediacenter/utils/ShortcutDbAdapter.java
index c1da8b9..8be077a 100644
--- a/src/com/archos/mediacenter/utils/ShortcutDbAdapter.java
+++ b/src/com/archos/mediacenter/utils/ShortcutDbAdapter.java
@@ -22,10 +22,15 @@ import android.database.sqlite.SQLiteDatabase;
 import android.database.sqlite.SQLiteException;
 import android.database.sqlite.SQLiteOpenHelper;
 import android.net.Uri;
+import android.os.Handler;
+import android.os.Looper;
 import android.util.Log;
+import android.widget.Toast;
 
 
 import com.archos.filecorelibrary.FileUtils;
+import com.archos.filecorelibrary.samba.SambaDiscovery;
+import com.archos.medialib.R;
 
 import java.io.Serializable;
 import java.util.ArrayList;
@@ -276,12 +281,47 @@ public enum ShortcutDbAdapter {
         }
     }
 
+    /**
+     * ReNova: the indexed folder reaching the same network share under another server name or IP
+     * (smb://TPLINK/Video vs smb://192.168.1.10/Video), or null. Indexing both made two copies of
+     * every video, each scraped on its own. Folders inside a root indexed with the same spelling are
+     * fine (rescans, subfolders).
+     */
+    public String findSameShareIndexedOtherwise(Context context, String uri) {
+        if (uri == null) return null;
+        List<Uri> indexed = getIndexedUris(context);
+        if (indexed == null) return null;
+        ShareEquivalence.Resolver resolver = SambaDiscovery::getIpFromShareName;
+        String conflict = null;
+        for (Uri root : indexed) {
+            String other = root.toString();
+            if (uri.startsWith(other) || other.startsWith(uri)) {
+                if (uri.startsWith(other)) return null; // inside a root indexed with this spelling
+                continue;
+            }
+            if (conflict == null && ShareEquivalence.overlaps(uri, other, resolver)) conflict = other;
+        }
+        return conflict;
+    }
+
+    /** @return true (after telling the user) when the folder is already indexed under another name */
+    public boolean refuseSameShareOtherName(Context context, String uri) {
+        final String conflict = findSameShareIndexedOtherwise(context, uri);
+        if (conflict == null) return false;
+        Log.w(TAG, "refusing " + uri + ": same share already indexed as " + conflict);
+        final Context app = context.getApplicationContext();
+        new Handler(Looper.getMainLooper()).post(() -> Toast.makeText(app,
+                app.getString(R.string.share_already_indexed_as, conflict), Toast.LENGTH_LONG).show());
+        return true;
+    }
+
     /**
      * NEW 2015: better have direct access to the DB
      * This new version does not need the ipPath parameter, it just use the regular path + a name
      * @return true if it succeeded
      */
     public boolean addShortcut(Context context, Shortcut shortcut) {
+        if (refuseSameShareOtherName(context, shortcut.getUri())) return false;
         SQLiteDatabase db = new DatabaseHelper(context).getWritableDatabase();
         ContentValues val = new ContentValues(2);
         val.put(KEY_PATH, shortcut.getUri());
diff --git a/src/com/archos/mediaprovider/NetworkScanner.java b/src/com/archos/mediaprovider/NetworkScanner.java
