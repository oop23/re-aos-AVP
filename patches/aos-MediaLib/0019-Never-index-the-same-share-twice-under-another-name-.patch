+package com.archos.mediacenter.utils;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+
+public class ShareEquivalenceTest {
+
+    private static final ShareEquivalence.Resolver NAS =
+            name -> name.equalsIgnoreCase("TPLINK") ? "192.168.1.10" : null;
+
+    @Test
+    public void sameShareByNameAndByIp() {
+        assertTrue(ShareEquivalence.sameFolderOtherSpelling("smb://TPLINK/Video/", "smb://192.168.1.10/video", NAS));
+        assertTrue(ShareEquivalence.overlaps("smb://tplink/Video/Anime/", "smb://192.168.1.10/Video", NAS));
+    }
+
+    @Test
+    public void differentServersOrFoldersDoNotOverlap() {
+        assertFalse(ShareEquivalence.overlaps("smb://OTHER/Video/", "smb://192.168.1.10/Video", NAS));
+        assertFalse(ShareEquivalence.overlaps("smb://192.168.1.10/Video2", "smb://192.168.1.10/Video", NAS));
+        assertFalse(ShareEquivalence.overlaps("ftp://h/x", "smb://h/x", NAS));
+    }
+
+    @Test
+    public void unknownNameStaysAName() {
+        assertEquals("smb://nas2/video/", ShareEquivalence.canonical("smb://NAS2/Video", NAS));
+        assertFalse(ShareEquivalence.sameFolderOtherSpelling("smb://NAS2/Video", "smb://192.168.1.10/Video", NAS));
+    }
+
+    @Test
+    public void localPathsAreNotNetworkShares() {
+        assertNull(ShareEquivalence.canonical("/storage/emulated/0/Movies", NAS));
+        assertFalse(ShareEquivalence.overlaps("/storage/x", "smb://h/x", NAS));
+    }
+
+    @Test
+    public void credentialsAndPortsAreHandled() {
+        assertEquals("sftp://192.168.1.10:2222/home/", ShareEquivalence.canonical("sftp://user@TPLINK:2222/home", NAS));
+    }
+}
