diff --git a/src/com/archos/mediacenter/utils/ShareEquivalence.java b/src/com/archos/mediacenter/utils/ShareEquivalence.java
new file mode 100644
index 0000000..b26a819
--- /dev/null
+++ b/src/com/archos/mediacenter/utils/ShareEquivalence.java
@@ -0,0 +1,76 @@
