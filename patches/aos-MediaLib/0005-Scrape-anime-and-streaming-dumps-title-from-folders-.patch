+package com.archos.mediascraper.preprocess;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import android.net.Uri;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.annotation.Config;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+
+/**
+ * Anime and streaming dump naming: title from the folders when the file only carries numbers,
+ * fansub "Title - 05" and polish "odc./Odcinek/Sezon" markers. Movies must never match.
+ */
+@RunWith(RobolectricTestRunner.class)
+@Config(sdk = 33)
+public class FolderEpisodeNamingTest {
+
+    private static String parse(String path) {
+        List<String> segments = new ArrayList<>(Arrays.asList(path.replaceFirst("^/", "").split("/")));
+        return String.valueOf(FolderEpisodeNaming.parse(segments));
+    }
+
+    @Test
+    public void titleFromFolderWhenFileHasOnlyNumbers() {
+        assertEquals("Frieren S1E5", parse("/Anime/Frieren/S01E05.mkv"));
+        assertEquals("Frieren S2E5", parse("/Anime/Frieren/Sezon 2/Odcinek 05.mp4"));
+        assertEquals("Shingeki no Kyojin S3E12", parse("/Anime/Shingeki no Kyojin/Season 3/E12.mkv"));
+        assertEquals("Frieren S1E5", parse("/Anime/Frieren/05.mkv"));
+        assertEquals("Frieren S1E5 (2023)", parse("/Anime/Frieren (2023)/05.mkv"));
+        assertEquals("Breaking Bad S1E1", parse("/Seriale/Breaking Bad/Season 1/Ep 1.mkv"));
+    }
+
+    @Test
+    public void seasonFromFolderName() {
+        assertEquals("Kimetsu no Yaiba S2E3", parse("/Anime/Kimetsu no Yaiba S2/Odcinek 03.mp4"));
+        assertEquals("Spy x Family S2E7", parse("/Anime/Spy x Family 2nd Season/07.mkv"));
+        assertEquals("Frieren S2E3", parse("/Anime/Frieren/Sezon 2/Frieren odc 3.mp4"));
+    }
+
+    @Test
+    public void fansubAndDumpNames() {
+        assertEquals("Sousou no Frieren S1E5", parse("/Anime/[SubsPlease] Sousou no Frieren - 05 (1080p) [ABCD1234].mkv"));
