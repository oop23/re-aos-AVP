+package com.archos.mediascraper.preprocess;
+
+import android.net.Uri;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+/**
+ * Episodes named the anime / streaming dump way, see {@link FolderEpisodeNaming}: runs after the
+ * regular TV show matchers and before the movie ones, so a file like {@code Frieren/05.mkv} or
+ * {@code Frieren/S01E05.mkv} is no longer searched as a movie called "05" or "S01E05".
+ */
+class FolderEpisodeMatcher implements InputMatcher {
+    private static final Logger log = LoggerFactory.getLogger(FolderEpisodeMatcher.class);
+
+    private static final FolderEpisodeMatcher INSTANCE = new FolderEpisodeMatcher();
+
+    public static FolderEpisodeMatcher instance() {
+        return INSTANCE;
+    }
+
+    private FolderEpisodeMatcher() {
+        // singleton
+    }
+
+    @Override
+    public boolean matchesUserInput(String userInput) {
+        return false;
+    }
+
+    @Override
+    public boolean matchesFileInput(Uri fileInput, Uri simplifiedUri) {
+        return fileInput != null && FolderEpisodeNaming.parse(fileInput.getPathSegments()) != null;
+    }
+
+    @Override
+    public SearchInfo getUserInputMatch(String userInput, Uri file) {
+        return null;
+    }
+
+    @Override
+    public SearchInfo getFileInputMatch(Uri file, Uri simplifiedUri) {
+        FolderEpisodeNaming.Result r = FolderEpisodeNaming.parse(file.getPathSegments());
+        if (r == null) return null;
+        if (log.isDebugEnabled()) log.debug("getFileInputMatch: {} -> {}", file, r);
+        return new TvShowSearchInfo(file, r.title, r.season, r.episode, r.year, null);
+    }
+
+    @Override
+    public String getMatcherName() {
+        return "FolderEpisode";
+    }
+}
diff --git a/src/com/archos/mediascraper/preprocess/FolderEpisodeNaming.java b/src/com/archos/mediascraper/preprocess/FolderEpisodeNaming.java
new file mode 100644
index 0000000..7aff306
--- /dev/null
+++ b/src/com/archos/mediascraper/preprocess/FolderEpisodeNaming.java
@@ -0,0 +1,228 @@
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//      http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package com.archos.mediascraper.preprocess;
+
+import java.util.List;
+import java.util.Locale;
+import java.util.Set;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * Episode naming the regular TV show patterns miss, typical of anime and of dumps from streaming
+ * sites (shinden & co) or fansub groups:
+ * <ul>
+ * <li>no show title in the file name: {@code Frieren/S01E05.mkv}, {@code Frieren/Sezon 2/Odcinek 05.mp4},
+ *     {@code Frieren/Season 2/E05.mkv}, {@code Frieren/05.mkv}: the title comes from the folders</li>
+ * <li>fansub style: {@code [SubsPlease] Sousou no Frieren - 05 (1080p) [ABCD1234].mkv}</li>
+ * <li>polish markers: {@code Frieren odc. 5.mp4}, {@code Frieren_Odcinek_05.mp4}</li>
+ * </ul>
+ * Pure Java on purpose (no Android types) so it is unit testable on the JVM.
+ */
+public final class FolderEpisodeNaming {
+
+    public static final class Result {
+        public final String title;
+        public final int season;
+        public final int episode;
+        public final String year;
+
+        Result(String title, int season, int episode, String year) {
+            this.title = title;
+            this.season = season;
+            this.episode = episode;
+            this.year = year;
+        }
+
+        @Override
+        public String toString() {
+            return title + " S" + season + "E" + episode + (year != null ? " (" + year + ")" : "");
+        }
+    }
+
+    private FolderEpisodeNaming() {}
+
+    private static final String SEASON_WORD = "(?:s|season|seas|sezon|saison|staffel|temporada)";
+    private static final String EPISODE_WORD = "(?:e|ep|episode|odc|odcinek|episodio|folge)";
+    private static final String SEP = "[\\s._\\-]*";
+
+    // "S01E05", "Season 1 Episode 5", "Sezon 2 Odcinek 05" with nothing before it
+    private static final Pattern SEASON_EPISODE_ONLY = Pattern.compile(
+            "(?i)^" + SEASON_WORD + SEP + "(\\d{1,2})" + SEP + EPISODE_WORD + "\\.?" + SEP + "(\\d{1,4})(?!\\d).*");
+    // "E05", "Ep 5", "Odcinek 05", "odc. 5" with nothing before it
+    private static final Pattern EPISODE_ONLY = Pattern.compile(
+            "(?i)^" + EPISODE_WORD + "\\.?" + SEP + "(\\d{1,4})(?!\\d).*");
+    // "05", "012", "05v2" (zero padded, otherwise movies like "300" or "9" would match)
+    private static final Pattern BARE_NUMBER = Pattern.compile("^(0\\d{1,3})(?:v\\d)?$");
+    // "Title - 05", "Title - 05v2 (1080p)", "Title - 1050"
+    private static final Pattern DASH_NUMBER = Pattern.compile(
+            "^(.+?)\\s+-\\s+(\\d{1,4})(?:v\\d)?(?:\\s+.*)?$");
+    // "Title odc. 5", "Title Odcinek 05", "Title Episode 5", "Title Ep05"
+    private static final Pattern TITLE_EPISODE_WORD = Pattern.compile(
+            "(?i)^(.+?)" + "[\\s._\\-]+" + "(?:ep|episode|odc|odcinek|episodio|folge)" + "\\.?" + SEP + "(\\d{1,4})(?!\\d).*");
+
+    // a season marker inside a title: "Frieren S2", "Shingeki no Kyojin Season 3", "Sezon 2"
+    private static final Pattern SEASON_IN_TITLE = Pattern.compile(
+            "(?i)(?:^|\\s)" + SEASON_WORD + SEP + "(\\d{1,2})(?:\\s|$)");
+    // "2nd Season", "3rd season"
+    private static final Pattern ORDINAL_SEASON_IN_TITLE = Pattern.compile(
+            "(?i)(?:^|\\s)(\\d{1,2})(?:st|nd|rd|th)\\s+season(?:\\s|$)");
+    // a folder that is only a season: "Season 2", "S02", "Sezon 2 [PL]"
+    private static final Pattern SEASON_FOLDER = Pattern.compile(
+            "(?i)^" + SEASON_WORD + SEP + "(\\d{1,2})(?:\\s.*)?$");
+
+    private static final Pattern BRACKETS = Pattern.compile("[\\[({<][^\\])}>]*[\\])}>]");
+    private static final Pattern YEAR = Pattern.compile("(?:^|\\s)((?:19|20)\\d{2})(?:\\s|$)");
+    private static final Pattern JUNK = Pattern.compile(
+            "(?i)\\b(?:480p|576p|720p|1080p|2160p|4k|uhd|hdr|hevc|x264|x265|h264|h265|aac|flac|web(?:-?dl|rip)?|bluray|bdrip|dvdrip|"
+                    + "multi|dual(?:audio)?|pl|eng|jap|jpn|napisy|lektor|dubbing|sub|subs|subbed|dub|dubbed)\\b");
+
+    // folders that never name a show
+    private static final Set<String> GENERIC_FOLDERS = Set.of(
+            "anime", "animes", "seriale", "serial", "series", "serie", "tv", "tv shows", "tvshows", "shows",
+            "download", "downloads", "pobrane", "video", "videos", "wideo", "filmy", "movies", "films", "bajki",
+            "media", "multimedia", "nowe", "new", "dump", "dumps", "shinden", "torrents", "public", "share",
+            "volume1", "storage", "emulated", "0", "sdcard", "mnt", "usb", "nas", "home");
+
+    /**
+     * @param pathSegments path segments of the video, the last one being the file name
+     * @return the parsed episode, or null when this naming does not apply
+     */
+    public static Result parse(List<String> pathSegments) {
+        if (pathSegments == null || pathSegments.isEmpty()) return null;
+        String fileName = stripExtension(pathSegments.get(pathSegments.size() - 1));
+        String name = normalize(fileName);
+        String withoutGroup = name.replaceFirst("^(?:\\[[^\\]]*\\]\\s*)+", "").trim();
+
+        Matcher m;
+        // 1. no title in the file: take it from the folders
+        if ((m = SEASON_EPISODE_ONLY.matcher(withoutGroup)).matches()) {
+            return fromFolders(pathSegments, toInt(m.group(1)), toInt(m.group(2)));
+        }
+        if ((m = EPISODE_ONLY.matcher(withoutGroup)).matches()) {
+            return fromFolders(pathSegments, -1, toInt(m.group(1)));
+        }
+        String bare = BRACKETS.matcher(withoutGroup).replaceAll(" ").trim();
+        if ((m = BARE_NUMBER.matcher(bare)).matches()) {
+            return fromFolders(pathSegments, -1, toInt(m.group(1)));
+        }
+        // 2. title in the file with an episode marker the generic patterns do not know
+        boolean groupTagged = !withoutGroup.equals(name);
+        if ((m = DASH_NUMBER.matcher(withoutGroup)).matches()) {
+            String number = m.group(2);
+            boolean plausible = groupTagged || number.startsWith("0")
+                    || BRACKETS.matcher(withoutGroup.substring(m.end(2))).find();
+            if (plausible && !number.matches("(?:19|20)\\d{2}")) {
+                return fromTitle(m.group(1), pathSegments, toInt(number));
+            }
+        }
+        if ((m = TITLE_EPISODE_WORD.matcher(withoutGroup)).matches()) {
+            return fromTitle(m.group(1), pathSegments, toInt(m.group(2)));
+        }
+        return null;
+    }
+
+    private static Result fromTitle(String rawTitle, List<String> segments, int episode) {
+        String title = cleanTitle(rawTitle);
+        if (title.isEmpty()) return null;
+        int season = seasonIn(rawTitle);
+        if (season > 0) title = cleanTitle(removeSeason(rawTitle));
+        if (season < 0) season = seasonFromFolders(segments);
+        String year = yearIn(rawTitle);
+        if (year != null) title = cleanTitle(removeYear(title));
+        return title.isEmpty() ? null : new Result(title, season > 0 ? season : 1, episode, year);
+    }
+
+    private static Result fromFolders(List<String> segments, int season, int episode) {
+        // walk up: skip season folders (remember their number), stop at the first real folder
+        for (int i = segments.size() - 2; i >= 0 && i >= segments.size() - 4; i--) {
+            String folder = normalize(segments.get(i));
+            Matcher sf = SEASON_FOLDER.matcher(folder);
+            if (sf.matches()) {
+                if (season < 0) season = toInt(sf.group(1));
+                continue;
+            }
+            String raw = folder.replaceFirst("^(?:\\[[^\\]]*\\]\\s*)+", "");
+            if (GENERIC_FOLDERS.contains(cleanTitle(raw).toLowerCase(Locale.ROOT))) return null;
+            int folderSeason = seasonIn(raw);
+            String title = cleanTitle(folderSeason > 0 ? removeSeason(raw) : raw);
+            if (season < 0 && folderSeason > 0) season = folderSeason;
+            String year = yearIn(raw);
+            if (year != null) title = cleanTitle(removeYear(title));
+            if (title.isEmpty() || GENERIC_FOLDERS.contains(title.toLowerCase(Locale.ROOT))) return null;
+            return new Result(title, season > 0 ? season : 1, episode, year);
+        }
+        return null;
+    }
+
+    private static int seasonFromFolders(List<String> segments) {
+        for (int i = segments.size() - 2; i >= 0 && i >= segments.size() - 3; i--) {
+            Matcher sf = SEASON_FOLDER.matcher(normalize(segments.get(i)));
+            if (sf.matches()) return toInt(sf.group(1));
+        }
+        return -1;
+    }
+
+    private static int seasonIn(String title) {
+        String t = normalize(title);
+        Matcher m = SEASON_IN_TITLE.matcher(t);
+        if (m.find()) return toInt(m.group(1));
+        m = ORDINAL_SEASON_IN_TITLE.matcher(t);
+        if (m.find()) return toInt(m.group(1));
+        return -1;
+    }
+
+    private static String removeSeason(String title) {
+        String t = normalize(title);
+        t = SEASON_IN_TITLE.matcher(t).replaceAll(" ");
+        t = ORDINAL_SEASON_IN_TITLE.matcher(t).replaceAll(" ");
+        return t;
+    }
+
+    private static String yearIn(String title) {
+        Matcher m = YEAR.matcher(normalize(title).replaceAll("[()\\[\\]]", " "));
+        return m.find() ? m.group(1) : null;
+    }
+
+    private static String removeYear(String title) {
+        return YEAR.matcher(title).replaceAll(" ");
+    }
+
+    static String cleanTitle(String raw) {
+        String t = normalize(raw);
+        t = BRACKETS.matcher(t).replaceAll(" ");
+        t = JUNK.matcher(t).replaceAll(" ");
+        t = t.replaceAll("[\\s\\-]+$", "").replaceAll("^[\\s\\-]+", "");
+        return t.replaceAll("\\s+", " ").trim();
+    }
+
+    private static String normalize(String s) {
+        // dots and underscores are word separators in release names, keep "S.W.A.T"-like acronyms
+        // out of scope: anime/dump names rarely use them
+        return s.replace('_', ' ').replaceAll("(?<=\\S)\\.(?=\\S)", " ").replaceAll("\\s+", " ").trim();
+    }
+
+    private static String stripExtension(String fileName) {
+        int dot = fileName.lastIndexOf('.');
+        if (dot > 0 && fileName.length() - dot <= 5) return fileName.substring(0, dot);
+        return fileName;
+    }
+
+    private static int toInt(String s) {
+        try {
+            return Integer.parseInt(s);
+        } catch (NumberFormatException e) {
+            return -1;
+        }
+    }
+}
