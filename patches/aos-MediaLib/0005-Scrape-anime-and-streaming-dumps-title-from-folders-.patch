+package com.archos.mediascraper;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import android.content.Context;
+
+import androidx.test.core.app.ApplicationProvider;
+
+import org.json.JSONObject;
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.annotation.Config;
+
+import java.util.Calendar;
+import java.util.TimeZone;
+
+@RunWith(RobolectricTestRunner.class)
+@Config(sdk = 33)
+public class MetadataOverridesTest {
+
+    private Context mContext;
+
+    @Before
+    public void setUp() {
+        mContext = ApplicationProvider.getApplicationContext();
+        mContext.getSharedPreferences("metadata_overrides", Context.MODE_PRIVATE).edit().clear().commit();
+    }
+
+    @Test
+    public void showEditsWinOverScrapedData() throws Exception {
+        JSONObject edits = new JSONObject()
+                .put(MetadataOverrides.TITLE, "Frieren: Beyond Journey's End")
+                .put(MetadataOverrides.PLOT, "my plot")
+                .put(MetadataOverrides.RATING, 9.5)
+                .put(MetadataOverrides.YEAR, 2023);
+        mContext.getSharedPreferences("metadata_overrides", Context.MODE_PRIVATE).edit()
+                .putString(MetadataOverrides.showKey(209867), edits.toString()).commit();
+
+        ShowTags scraped = new ShowTags();
+        scraped.setOnlineId(209867);
+        scraped.setTitle("Sousou no Frieren");
+        scraped.setPlot("scraped plot");
+        scraped.setRating(7f);
+
+        MetadataOverrides.applyTo(mContext, scraped);
+
+        assertEquals("Frieren: Beyond Journey's End", scraped.getTitle());
+        assertEquals("my plot", scraped.getPlot());
+        assertEquals(9.5f, scraped.getRating(), 0.001f);
+        Calendar c = Calendar.getInstance(TimeZone.getTimeZone("UTC"));
+        c.setTime(scraped.getPremiered());
+        assertEquals(2023, c.get(Calendar.YEAR));
+    }
+
+    @Test
+    public void otherShowsAreUntouched() {
+        ShowTags other = new ShowTags();
+        other.setOnlineId(1);
+        other.setTitle("Other");
+        MetadataOverrides.applyTo(mContext, other);
+        assertEquals("Other", other.getTitle());
+    }
+
+    @Test
+    public void clearForgetsEdits() throws Exception {
+        String key = MetadataOverrides.movieKey("smb://nas/Filmy/a.mkv");
+        mContext.getSharedPreferences("metadata_overrides", Context.MODE_PRIVATE).edit()
+                .putString(key, new JSONObject().put(MetadataOverrides.TITLE, "x").toString()).commit();
+        assertTrue(MetadataOverrides.has(mContext, key));
+        MetadataOverrides.clear(mContext, key);
+        assertFalse(MetadataOverrides.has(mContext, key));
+    }
+
+    @Test
+    public void januaryFirstIsUtcMidnight() {
+        Calendar c = Calendar.getInstance(TimeZone.getTimeZone("UTC"));
+        c.setTimeInMillis(MetadataOverrides.januaryFirst(1999));
+        assertEquals(1999, c.get(Calendar.YEAR));
+        assertEquals(Calendar.JANUARY, c.get(Calendar.MONTH));
+        assertEquals(1, c.get(Calendar.DAY_OF_MONTH));
+    }
+}
