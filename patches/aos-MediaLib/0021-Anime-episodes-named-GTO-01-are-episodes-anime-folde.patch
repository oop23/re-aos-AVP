 .../themoviedb3/SearchMovie2.java             | 10 +++++-
 .../themoviedb3/SearchMovieParser2.java       | 14 ++++++--
 .../themoviedb3/SearchShowParser.java         |  2 +-
 .../mediascraper/xml/MovieScraper3.java       |  9 +++---
 .../preprocess/FolderEpisodeNamingTest.java   | 16 ++++++++++
 6 files changed, 75 insertions(+), 8 deletions(-)

diff --git a/src/com/archos/mediascraper/preprocess/FolderEpisodeNaming.java b/src/com/archos/mediascraper/preprocess/FolderEpisodeNaming.java
index 5430267..881adea 100644
--- a/src/com/archos/mediascraper/preprocess/FolderEpisodeNaming.java
+++ b/src/com/archos/mediascraper/preprocess/FolderEpisodeNaming.java
@@ -73,6 +73,17 @@ public final class FolderEpisodeNaming {
     private static final Pattern TITLE_EPISODE_WORD = Pattern.compile(
             "(?i)^(.+?)" + "[\\s._\\-]+" + "(?:ep|episode|odc|odcinek|episodio|folge)" + "\\.?" + SEP + "(\\d{1,4})(?!\\d).*");
 
+    // "GTO 01", "Naruto 001 [1080p]": zero padded number at the end, nothing but tags after it
+    private static final Pattern TITLE_PADDED_NUMBER = Pattern.compile(
+            "^(.+?)\\s+(0\\d{1,3})(?:v\\d)?(?:\\s*[\\[(].*)?$");
+    // "GTO 12" inside Anime/GTO/: the folder names the show, the number is the episode
+    private static final Pattern TITLE_NUMBER = Pattern.compile(
+            "^(.+?)\\s+(\\d{1,3})(?:v\\d)?(?:\\s*[\\[(].*)?$");
+    private static final Pattern ANIME_FOLDER = Pattern.compile("(?i)^animes?(?:\\s.*)?$");
+    // "Movie CD 01", "Kill Bill Vol 01": parts of a movie, not episodes
+    private static final Pattern PART_WORD_BEFORE = Pattern.compile(
+            "(?i).*\\b(?:cd|disc|disk|dvd|part|pt|vol|volume|chapter|rozdzial|rozdział|czesc|część|cz)\\.?$");
+
     // a season marker inside a title: "Frieren S2", "Shingeki no Kyojin Season 3", "Sezon 2"
     private static final Pattern SEASON_IN_TITLE = Pattern.compile(
             "(?i)(?:^|\\s)" + SEASON_WORD + SEP + "(\\d{1,2})(?:\\s|$)");
@@ -131,9 +142,30 @@ public final class FolderEpisodeNaming {
         if ((m = TITLE_EPISODE_WORD.matcher(withoutGroup)).matches()) {
             return fromTitle(m.group(1), pathSegments, toInt(m.group(2)));
         }
+        if ((m = TITLE_PADDED_NUMBER.matcher(withoutGroup)).matches()) {
+            String title = m.group(1).trim();
+            if (!PART_WORD_BEFORE.matcher(title).matches() && !"007".equals(m.group(2))) {
+                return fromTitle(title, pathSegments, toInt(m.group(2)));
+            }
+        }
+        if ((m = TITLE_NUMBER.matcher(withoutGroup)).matches() && inAnimeFolder(pathSegments)
+                && pathSegments.size() >= 2) {
+            String title = m.group(1).trim();
+            String parent = cleanTitle(pathSegments.get(pathSegments.size() - 2));
+            if (!PART_WORD_BEFORE.matcher(title).matches() && cleanTitle(title).equalsIgnoreCase(parent)) {
+                return fromTitle(title, pathSegments, toInt(m.group(2)));
+            }
+        }
         return null;
     }
 
+    private static boolean inAnimeFolder(List<String> segments) {
+        for (int i = 0; i < segments.size() - 1; i++) {
+            if (ANIME_FOLDER.matcher(segments.get(i).trim()).matches()) return true;
+        }
+        return false;
+    }
+
     private static Result fromTitle(String rawTitle, List<String> segments, int episode) {
         String title = cleanTitle(rawTitle);
         if (title.isEmpty()) return null;
