+// limitations under the License.
+
+package com.archos.mediacenter.utils;
+
+import static org.junit.Assert.assertEquals;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.annotation.Config;
+
+@RunWith(RobolectricTestRunner.class)
+@Config(manifest = Config.NONE, sdk = 33)
+public class FormatTimeTest {
+    @Test
+    public void clockStyle() {
+        assertEquals("", MediaUtils.formatTime(0));
+        assertEquals("0:45", MediaUtils.formatTime(45_000));
+        assertEquals("1:25", MediaUtils.formatTime(85_000));
+        assertEquals("59:59", MediaUtils.formatTime(3_599_000));
+        assertEquals("1:05:30", MediaUtils.formatTime(3_930_000));
+        assertEquals("2:00:00", MediaUtils.formatTime(7_200_400));
+    }
+}
