+package com.archos.mediascraper.themoviedb3;
+
+import java.util.Locale;
+
+/**
+ * Order of the artwork offered for a movie or a show, the Kodi way:
+ * <ul>
+ * <li>backdrops: textless first (a backdrop with a title written on it fights with the UI text
+ *     drawn over it), then the best rated, large ones before small ones</li>
+ * <li>posters: in the user's language first, then English, then textless, then the rest</li>
+ * </ul>
+ * Ratings are weighted by their number of votes: a single 10/10 vote no longer beats a poster
+ * rated 7.5 by fifty people.
+ *
+ * Pure Java (no Android types) so it is unit testable on the JVM.
+ */
+public final class ArtworkRanking {
+
+    private ArtworkRanking() {}
+
+    // prior: what an image with no votes is worth, and how many votes it takes to move away from it
+    private static final double PRIOR_RATING = 5.0;
+    private static final double PRIOR_VOTES = 3.0;
+
+    /** Vote-count weighted rating (bayesian average), 0..10. */
+    static double weightedRating(Number voteAverage, Number voteCount) {
+        double average = voteAverage == null ? 0 : voteAverage.doubleValue();
+        double count = voteCount == null ? 0 : Math.max(0, voteCount.doubleValue());
+        return (average * count + PRIOR_RATING * PRIOR_VOTES) / (count + PRIOR_VOTES);
+    }
+
+    /** Higher is better. */
+    public static double backdropScore(String imageLanguage, Number voteAverage, Number voteCount, Number width) {
+        double score = weightedRating(voteAverage, voteCount);
+        if (isTextless(imageLanguage)) score += 100;
+        if (width != null && width.intValue() >= 1920) score += 1;
+        return score;
+    }
+
+    /** Higher is better. */
+    public static double posterScore(String imageLanguage, String preferredLanguage, Number voteAverage, Number voteCount) {
+        double score = weightedRating(voteAverage, voteCount);
+        String lang = normalize(imageLanguage);
+        String preferred = normalize(preferredLanguage);
+        if (preferred != null && preferred.equals(lang)) score += 300;
+        else if ("en".equals(lang)) score += 200;
+        else if (lang == null) score += 100;
+        return score;
+    }
+
+    private static boolean isTextless(String imageLanguage) {
+        return normalize(imageLanguage) == null;
+    }
+
+    /** "pt-BR" -> "pt", "xx" (TMDb's no language) / "" / "null" -> null */
+    static String normalize(String language) {
+        if (language == null) return null;
+        String l = language.trim().toLowerCase(Locale.ROOT);
+        int dash = l.indexOf('-');
+        if (dash > 0) l = l.substring(0, dash);
+        if (l.isEmpty() || "xx".equals(l) || "null".equals(l)) return null;
+        return l;
+    }
+}
