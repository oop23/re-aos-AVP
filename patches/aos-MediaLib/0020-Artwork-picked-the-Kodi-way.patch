+package com.archos.mediascraper.themoviedb3;
+
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+
+public class ArtworkRankingTest {
+
+    @Test
+    public void textlessBackdropBeatsBetterRatedBackdropWithText() {
+        assertTrue(ArtworkRanking.backdropScore(null, 5.2f, 4, 1920)
+                > ArtworkRanking.backdropScore("en", 9.0f, 80, 3840));
+        assertTrue(ArtworkRanking.backdropScore("xx", 5.2f, 4, 1280)
+                > ArtworkRanking.backdropScore("pl", 9.0f, 80, 3840));
+    }
+
+    @Test
+    public void posterLanguageOrder() {
+        double pl = ArtworkRanking.posterScore("pl", "pl-PL", 5.0f, 2);
+        double en = ArtworkRanking.posterScore("en", "pl-PL", 9.0f, 100);
+        double none = ArtworkRanking.posterScore(null, "pl-PL", 9.5f, 100);
+        double ja = ArtworkRanking.posterScore("ja", "pl-PL", 10.0f, 500);
+        assertTrue(pl > en);
+        assertTrue(en > none);
+        assertTrue(none > ja);
+    }
+
+    @Test
+    public void fewVotesDoNotBeatManyGoodVotes() {
+        assertTrue(ArtworkRanking.weightedRating(7.5f, 50) > ArtworkRanking.weightedRating(10.0f, 1));
+    }
+
+    @Test
+    public void noLanguageMarkers() {
+        assertNull(ArtworkRanking.normalize("xx"));
+        assertNull(ArtworkRanking.normalize(""));
+        assertNull(ArtworkRanking.normalize(null));
+    }
+}
