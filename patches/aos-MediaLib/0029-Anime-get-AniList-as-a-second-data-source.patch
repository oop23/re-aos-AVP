+    /**
+     * The best AniList match of {@code query} with its description and score, null when nothing
+     * matched or AniList is unreachable. Blocking: call it from a scraper thread.
+     */
+    public static Media media(String query) {
+        if (query == null || query.trim().length() < 2) return null;
+        alternateTitles(query); // fills the caches
+        return sMediaCache.get(query.trim().toLowerCase(Locale.ROOT));
+    }
+
+    /** Parses the best match of an AniList answer. Package visible for tests. */
+    static Media parseMedia(String json) throws JSONException {
+        JSONObject root = new JSONObject(json);
+        JSONObject data = root.optJSONObject("data");
+        JSONObject page = data == null ? null : data.optJSONObject("Page");
+        JSONArray media = page == null ? null : page.optJSONArray("media");
+        if (media == null || media.length() == 0) return null;
+        JSONObject best = media.getJSONObject(0);
+        String description = best.isNull("description") ? null : cleanDescription(best.optString("description", null));
+        return new Media(best.optInt("id", 0), best.optInt("idMal", 0), parseTitles(json),
+                description, best.optInt("averageScore", 0));
+    }
+
+    /** AniList descriptions carry html line breaks, italics and a "(Source: ...)" credit. */
+    static String cleanDescription(String description) {
+        if (description == null) return null;
+        String d = description.replaceAll("(?i)<br\\s*/?>", "\n").replaceAll("<[^>]+>", "")
+                .replace("&quot;", "\"").replace("&amp;", "&").replace("&#039;", "'").replace("&lt;", "<").replace("&gt;", ">");
+        d = d.replaceAll("(?is)\\(\\s*source:[^)]*\\)\\s*$", "").replaceAll("(?is)\\[\\s*written by[^\\]]*\\]\\s*$", "");
+        d = d.replaceAll("[ \\t]+", " ").replaceAll("\\n{3,}", "\n\n").trim();
+        return d.isEmpty() ? null : d;
+    }
+
     /** {AniList id, MyAnimeList id} of the best match, 0 when unknown. Package visible for tests. */
     static int[] parseIds(String json) throws JSONException {
         JSONObject root = new JSONObject(json);
