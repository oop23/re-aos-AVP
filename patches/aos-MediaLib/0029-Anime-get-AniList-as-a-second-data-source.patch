+    private static final int ANIMATION_GENRE_ID = 16;
+
+    /** Japanese animation: TMDb animation genre and a japanese origin. */
+    static boolean isAnime(TvShow serie) {
+        boolean animation = false;
+        if (serie.genres != null) for (Genre g : serie.genres) if (g != null && g.id != null && g.id == ANIMATION_GENRE_ID) animation = true;
+        boolean japanese = "ja".equals(serie.original_language)
+                || (serie.origin_country != null && serie.origin_country.contains("JP"));
+        return animation && japanese;
+    }
+
+    /**
+     * ReNova: anime get AniList as a second source. TMDb often has no text in the user's language
+     * (or a poor one) for anime: AniList's description replaces an english or missing TMDb plot, its
+     * score fills a missing rating, and the show is credited to AniList on the details screens.
+     */
+    private static void enrichAnimeFromAniList(TvShow serie, ShowTags result) {
+        if (!isAnime(serie)) return;
+        com.archos.mediascraper.anilist.AniListClient.Media media = null;
+        for (String query : new String[] { serie.original_name, serie.name }) {
+            if (query == null) continue;
+            com.archos.mediascraper.anilist.AniListClient.Media candidate = com.archos.mediascraper.anilist.AniListClient.media(query);
+            if (candidate != null && AnimeTitleMatch.matches(serie.name, serie.original_name, candidate.titles)) {
+                media = candidate;
+                break;
+            }
+        }
+        if (media == null) return;
+        com.archos.mediascraper.DataSources.markAniListShow(serie.id, media.id, media.idMal);
+        boolean localizedPlot = serie.overview != null && !serie.overview.trim().isEmpty();
+        if (!localizedPlot && media.description != null) {
+            if (log.isDebugEnabled()) log.debug("enrichAnimeFromAniList: {} plot from AniList", serie.name);
+            result.setPlot(media.description);
+        }
+        if (result.getRating() <= 0 && media.averageScore > 0) {
+            result.setRating(Math.round(media.averageScore) / 10.0f);
+        }
+    }
+
     // many genres are not translated on tmdb and localized request is returned in the local language making one to
     // one mapping difficult without changing all db structure --> revert to show trick which is the only way to cope
     // with fallback search in en is perfomed when localized search returns nothing
