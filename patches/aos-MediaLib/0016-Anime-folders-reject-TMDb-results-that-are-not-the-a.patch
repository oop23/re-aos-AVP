 .../mediascraper/themoviedb3/SearchShow.java  | 19 ++++-
 .../themoviedb3/SearchShowParser.java         | 13 ++++
 .../themoviedb3/AnimeTitleMatchTest.java      | 52 +++++++++++++
 4 files changed, 157 insertions(+), 1 deletion(-)
 create mode 100644 src/com/archos/mediascraper/themoviedb3/AnimeTitleMatch.java
 create mode 100644 test/java/com/archos/mediascraper/themoviedb3/AnimeTitleMatchTest.java

