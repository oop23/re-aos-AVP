+package com.archos.mediascraper.themoviedb3;
+
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+
+import java.util.Arrays;
+import java.util.List;
+
+public class AnimeTitleMatchTest {
+
+    private static final List<String> KONOSUBA = Arrays.asList(
+            "KONOSUBA -God's blessing on this wonderful world!",
+            "Kono Subarashii Sekai ni Shukufuku wo!", "この素晴らしい世界に祝福を!");
+    private static final List<String> FRIEREN = Arrays.asList(
+            "Frieren: Beyond Journey's End", "Sousou no Frieren", "葬送のフリーレン");
+
+    @Test
+    public void realMatchesAreKept() {
+        assertTrue(AnimeTitleMatch.matches("KonoSuba – God’s blessing on this wonderful world!!", "この素晴らしい世界に祝福を！", KONOSUBA));
+        assertTrue(AnimeTitleMatch.matches("Frieren: Beyond Journey's End", "葬送のフリーレン", FRIEREN));
+        assertTrue(AnimeTitleMatch.matches("Frieren", "葬送のフリーレン", FRIEREN));
+        assertTrue(AnimeTitleMatch.matches("Attack on Titan", "進撃の巨人",
+                Arrays.asList("Attack on Titan", "Shingeki no Kyojin", "進撃の巨人")));
+    }
+
+    @Test
+    public void liesAreRejected() {
+        assertFalse(AnimeTitleMatch.matches("Kung Fu Panda: The Paws of Destiny", "Kung Fu Panda: The Paws of Destiny", KONOSUBA));
+        assertFalse(AnimeTitleMatch.matches("Frasier", "Frasier", FRIEREN));
+        assertFalse(AnimeTitleMatch.matches("Titans", "Titans",
+                Arrays.asList("Attack on Titan", "Shingeki no Kyojin", "進撃の巨人")));
+    }
+
+    @Test
+    public void noAniListDataAcceptsEverything() {
+        assertTrue(AnimeTitleMatch.matches("Anything", "Anything", null));
+    }
+}
