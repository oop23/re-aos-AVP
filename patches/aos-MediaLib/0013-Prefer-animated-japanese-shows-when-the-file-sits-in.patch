+package com.archos.mediascraper.themoviedb3;
+
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import android.net.Uri;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.annotation.Config;
+
+@RunWith(RobolectricTestRunner.class)
+@Config(manifest = Config.NONE, sdk = 33)
+public class AnimePathTest {
+
+    @Test
+    public void animeFolders() {
+        assertTrue(SearchShowParser.isAnimePath(Uri.parse("smb://nas/video/Anime/Frieren/S01E05.mkv")));
+        assertTrue(SearchShowParser.isAnimePath(Uri.parse("smb://nas/video/animes/Frieren/S01E05.mkv")));
+        assertTrue(SearchShowParser.isAnimePath(Uri.parse("smb://nas/Seriale anime/Frieren/S01E05.mkv")));
+        assertTrue(SearchShowParser.isAnimePath(Uri.parse("file:///storage/emulated/0/Anime 2024/Frieren - 05.mkv")));
+    }
+
+    @Test
+    public void otherFolders() {
+        assertFalse(SearchShowParser.isAnimePath(Uri.parse("smb://nas/video/Seriale/Breaking Bad/S01E01.mkv")));
+        assertFalse(SearchShowParser.isAnimePath(Uri.parse("smb://nas/video/Animaniacs/S01E01.mkv")));
+        assertFalse(SearchShowParser.isAnimePath(null));
+    }
+}
