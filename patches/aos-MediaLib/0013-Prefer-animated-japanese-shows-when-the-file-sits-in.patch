From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: oop23 <ilidans01yt@gmail.com>
Date: Sat, 10 Oct 2026 04:30:34 +0000
Subject: [PATCH] Prefer animated japanese shows when the file sits in an anime
 folder

In a folder named like 'Anime', TV search results that are not
animation get a penalty and japanese animation a small bonus, so anime
no longer match live action shows with a similar title.
---
 .../themoviedb3/SearchShowParser.java         | 22 ++++++++++
 .../themoviedb3/AnimePathTest.java            | 43 +++++++++++++++++++
 2 files changed, 65 insertions(+)
 create mode 100644 test/java/com/archos/mediascraper/themoviedb3/AnimePathTest.java

diff --git a/src/com/archos/mediascraper/themoviedb3/SearchShowParser.java b/src/com/archos/mediascraper/themoviedb3/SearchShowParser.java
index 6210ea0..3277d3e 100644
--- a/src/com/archos/mediascraper/themoviedb3/SearchShowParser.java
+++ b/src/com/archos/mediascraper/themoviedb3/SearchShowParser.java
@@ -51,6 +51,19 @@ public class SearchShowParser {
         return results;
     }
 
+    private static final int ANIMATION_GENRE_ID = 16;
+    private static final java.util.regex.Pattern ANIME_FOLDER =
+            java.util.regex.Pattern.compile("(?i)^(?:anime|animes|anime[\\s._-].*|.*[\\s._-]anime)$");
+
+    /** a folder named like "Anime", "Animes", "Anime 2024", "Seriale anime" in the path */
+    static boolean isAnimePath(android.net.Uri file) {
+        if (file == null || file.getPathSegments() == null) return false;
+        for (String segment : file.getPathSegments()) {
+            if (segment != null && ANIME_FOLDER.matcher(segment.trim()).matches()) return true;
+        }
+        return false;
+    }
+
     private static SearchParserResult getSearchShowParserResult(Response<TvShowResultsPage> response,
                                                                     TvShowSearchInfo searchInfo, Integer year, String language, ShowScraper4 showScraper) {
         SearchParserResult searchShowParserResult = new SearchParserResult();
@@ -61,6 +74,7 @@ public class SearchShowParser {
         List<BaseTvShow> resultsTvShow = new ArrayList<>(response.body().results);
 
         boolean isAirDateKnown = false;
+        boolean animePath = isAnimePath(searchInfo.getFile());
         for (BaseTvShow series : resultsTvShow) {
             if (log.isDebugEnabled()) log.debug("airdate {} airtime {}", series.name, ((series.first_air_date != null) ? series.first_air_date.toString() : null));
             if (series.id != SERIES_NOT_PERMITTED_ID) {
@@ -109,6 +123,14 @@ public class SearchShowParser {
                     if (log.isDebugEnabled()) log.debug("getSearchShowParserResult: acronym head match for {} against {}/{}, boosting distance to 0", showNameLC, result.getOriginalTitle().toLowerCase(), result.getTitle().toLowerCase());
                     distance = 0;
                 }
+                // ReNova: in an anime folder, an animated japanese show beats a live action namesake
+                // (anime used to match random shows/movies with a similar title)
+                if (animePath) {
+                    boolean animated = series.genre_ids != null && series.genre_ids.contains(ANIMATION_GENRE_ID);
+                    boolean japanese = series.origin_country != null && series.origin_country.contains("JP");
+                    if (!animated) distance += 3;
+                    else if (japanese) distance = Math.max(0, distance - 1);
+                }
                 result.setLevenshteinDistance(distance);
                 result.setReleaseOrFirstAiredDate(series.first_air_date);
                 if (log.isDebugEnabled()) log.debug("getSearchShowParserResult: between {} and {}/{} levenshteinDistanceTitle={}, levenshteinDistanceOriginalTitle={}, popularity={}, airdate={}, year={}", showNameLC, result.getOriginalTitle().toLowerCase(), result.getTitle().toLowerCase(), levenshteinDistanceTitle, levenshteinDistanceOriginalTitle, result.getPopularity(), series.first_air_date, result.getYear());
diff --git a/test/java/com/archos/mediascraper/themoviedb3/AnimePathTest.java b/test/java/com/archos/mediascraper/themoviedb3/AnimePathTest.java
new file mode 100644
index 0000000..8e3685a
--- /dev/null
+++ b/test/java/com/archos/mediascraper/themoviedb3/AnimePathTest.java
@@ -0,0 +1,43 @@
