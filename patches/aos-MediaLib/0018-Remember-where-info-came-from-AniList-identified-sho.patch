+package com.archos.mediascraper;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.net.Uri;
+
+import com.archos.environment.ArchosUtils;
+
+/**
+ * Remembers which services helped identify a title, so the details screens can credit them with
+ * their logos (TMDb and IMDb are known from the ids stored with the tags).
+ *
+ * Kept on the device in private preferences, like everything ReNova learns about the library.
+ */
+public final class DataSources {
+
+    private static final String PREFS = "data_sources";
+    private static final String ANILIST_SHOW = "anilist:show:";
+    private static final String NFO = "nfo:";
+
+    private DataSources() {}
+
+    /** The TMDb show was found or confirmed through AniList titles. */
+    public static void markAniListShow(long tmdbShowId) {
+        if (tmdbShowId <= 0) return;
+        Context context = ArchosUtils.getGlobalContext();
+        if (context == null) return;
+        SharedPreferences prefs = prefs(context);
+        String key = ANILIST_SHOW + tmdbShowId;
+        if (!prefs.getBoolean(key, false)) prefs.edit().putBoolean(key, true).apply();
+    }
+
+    public static boolean isAniListShow(Context context, long tmdbShowId) {
+        return tmdbShowId > 0 && prefs(context).getBoolean(ANILIST_SHOW + tmdbShowId, false);
+    }
+
+    /** The info of this video was read from an .nfo file next to it. */
+    public static void markNfo(Context context, Uri video) {
+        if (context == null || video == null) return;
+        SharedPreferences prefs = prefs(context);
+        String key = NFO + video;
+        if (!prefs.getBoolean(key, false)) prefs.edit().putBoolean(key, true).apply();
+    }
+
+    public static boolean isNfo(Context context, String videoPath) {
+        return videoPath != null && prefs(context).getBoolean(NFO + videoPath, false);
+    }
+
+    private static SharedPreferences prefs(Context context) {
+        return context.getApplicationContext().getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+}
