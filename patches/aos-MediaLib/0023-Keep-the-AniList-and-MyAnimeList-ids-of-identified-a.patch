@@ -182,7 +182,7 @@ public class SearchShow {
                     myResult.result = SearchShowParser.getResult(
                             (isResponseOk) ? response : null,
                             searchInfo, year, language, resultLimit, showScraper);
-                    if (foundThroughAniList) markAniList(myResult.result);
+                    if (foundThroughAniList) markAniList(myResult.result, searchQueryString);
                     if ((myResult.result == null || myResult.result.isEmpty())
                             && SearchShowParser.isAnimePath(searchInfo.getFile())) {
                         // every result was rejected as not being the anime: search TMDb again under
@@ -195,7 +195,7 @@ public class SearchShow {
                                 if (log.isDebugEnabled()) log.debug("search: anime retry with AniList title {} in {}", alternateTitle, lang);
                                 myResult.result = SearchShowParser.getResult(retry, searchInfo, year, lang, resultLimit, showScraper);
                                 if (myResult.result != null && !myResult.result.isEmpty()) {
-                                    markAniList(myResult.result);
+                                    markAniList(myResult.result, searchQueryString);
                                     break;
                                 }
                             }
@@ -219,9 +219,10 @@ public class SearchShow {
         return myResult;
     }
 
-    private static void markAniList(List<SearchResult> results) {
+    private static void markAniList(List<SearchResult> results, String query) {
         if (results == null) return;
-        for (SearchResult result : results) com.archos.mediascraper.DataSources.markAniListShow(result.getId());
+        int[] ids = AniListClient.knownIds(query);
+        for (SearchResult result : results) com.archos.mediascraper.DataSources.markAniListShow(result.getId(), ids[0], ids[1]);
     }
 
     public static void debugLruCache(LruCache<String, Response<TvShowResultsPage>> lruCache) {
diff --git a/src/com/archos/mediascraper/themoviedb3/SearchShowParser.java b/src/com/archos/mediascraper/themoviedb3/SearchShowParser.java
index edb49af..6f6a5d0 100644
