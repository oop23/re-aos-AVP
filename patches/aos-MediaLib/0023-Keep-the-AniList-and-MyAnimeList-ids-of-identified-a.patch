                         continue;
                     }
                     // AniList confirmed this one: credit it on the details screens
-                    com.archos.mediascraper.DataSources.markAniListShow(series.id);
+                    int[] aniListIds = com.archos.mediascraper.anilist.AniListClient.knownIds(searchInfo.getShowName());
+                    com.archos.mediascraper.DataSources.markAniListShow(series.id, aniListIds[0], aniListIds[1]);
                 }
                 Bundle extra = new Bundle();
