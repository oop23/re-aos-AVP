@@ -12,6 +12,7 @@
 
 package com.archos.mediascraper.anilist;
 
+import static org.junit.Assert.assertArrayEquals;
 import static org.junit.Assert.assertEquals;
 import static org.junit.Assert.assertTrue;
 
@@ -49,4 +50,11 @@ public class AniListClientTest {
         assertTrue(AniListClient.parseTitles("{\"data\":{\"Page\":{\"media\":[]}}}").isEmpty());
         assertTrue(AniListClient.parseTitles("{\"errors\":[{\"message\":\"Too Many Requests\"}],\"data\":null}").isEmpty());
     }
+
+    @Test
+    public void idsOfTheBestMatch() throws Exception {
+        String json = "{\"data\":{\"Page\":{\"media\":[{\"id\":154587,\"idMal\":52991,\"title\":{\"romaji\":\"Sousou no Frieren\"}}]}}}";
+        assertArrayEquals(new int[] { 154587, 52991 }, AniListClient.parseIds(json));
+        assertArrayEquals(new int[] { 0, 0 }, AniListClient.parseIds("{\"data\":{\"Page\":{\"media\":[]}}}"));
+    }
