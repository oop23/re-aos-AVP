new file mode 100644
index 0000000..0bbabb8
--- /dev/null
+++ b/res/drawable/renova_dialog_background_black.xml
@@ -0,0 +1,18 @@
+<?xml version="1.0" encoding="utf-8"?>
+<inset xmlns:android="http://schemas.android.com/apk/res/android"
+    android:insetLeft="20dp"
+    android:insetTop="24dp"
+    android:insetRight="20dp"
+    android:insetBottom="24dp">
+    <shape android:shape="rectangle">
+        <corners android:radius="28dp" />
+        <gradient
+            android:angle="270"
+            android:startColor="@color/renova_dialog_black_top"
+            android:endColor="@color/renova_dialog_black_bottom"
+            android:type="linear" />
+        <stroke
+            android:width="1dp"
+            android:color="@color/renova_dialog_edge" />
+    </shape>
+</inset>
diff --git a/res/values-v31/colors.xml b/res/values-v31/colors.xml
new file mode 100644
index 0000000..931ea8a
--- /dev/null
+++ b/res/values-v31/colors.xml
@@ -0,0 +1,8 @@
+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <!-- frosted glass: the content behind the dialog is blurred, let a little of it through -->
+    <color name="renova_dialog_top">#E6241A5C</color>
+    <color name="renova_dialog_bottom">#EB130D36</color>
+    <color name="renova_dialog_black_top">#E6262626</color>
+    <color name="renova_dialog_black_bottom">#EB141414</color>
+</resources>
diff --git a/res/values-v31/themes.xml b/res/values-v31/themes.xml
new file mode 100644
index 0000000..8810b18
--- /dev/null
+++ b/res/values-v31/themes.xml
@@ -0,0 +1,40 @@
+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <!-- Android 12+: what is behind a dialog is blurred, not only dimmed -->
+    <style name="Theme.AlertDialog" parent="ReNovaBase.Theme.AlertDialog">
+        <item name="android:windowBlurBehindEnabled">true</item>
+        <item name="android:windowBlurBehindRadius">@dimen/renova_dialog_blur</item>
+        <item name="android:backgroundDimAmount">0.4</item>
+    </style>
+
+    <style name="Theme.AlertDialog.Black" parent="ReNovaBase.Theme.AlertDialog.Black">
+        <item name="android:windowBlurBehindEnabled">true</item>
+        <item name="android:windowBlurBehindRadius">@dimen/renova_dialog_blur</item>
+        <item name="android:backgroundDimAmount">0.4</item>
+    </style>
+
+    <style name="ThemeOverlay.ReNova.MaterialAlertDialog" parent="ReNovaBase.ThemeOverlay.ReNova.MaterialAlertDialog">
+        <item name="android:windowBlurBehindEnabled">true</item>
+        <item name="android:windowBlurBehindRadius">@dimen/renova_dialog_blur</item>
+        <item name="android:backgroundDimAmount">0.4</item>
+    </style>
+
+    <style name="ThemeOverlay.ReNova.MaterialAlertDialog.Black" parent="ReNovaBase.ThemeOverlay.ReNova.MaterialAlertDialog.Black">
+        <item name="android:windowBlurBehindEnabled">true</item>
+        <item name="android:windowBlurBehindRadius">@dimen/renova_dialog_blur</item>
+        <item name="android:backgroundDimAmount">0.4</item>
+    </style>
+
+    <style name="Theme.ReNova.FrameworkAlertDialog" parent="ReNovaBase.Theme.ReNova.FrameworkAlertDialog">
+        <item name="android:windowBlurBehindEnabled">true</item>
+        <item name="android:windowBlurBehindRadius">@dimen/renova_dialog_blur</item>
+        <item name="android:backgroundDimAmount">0.4</item>
+    </style>
+
+    <style name="Theme.ReNova.FrameworkAlertDialog.Black" parent="ReNovaBase.Theme.ReNova.FrameworkAlertDialog.Black">
+        <item name="android:windowBlurBehindEnabled">true</item>
+        <item name="android:windowBlurBehindRadius">@dimen/renova_dialog_blur</item>
+        <item name="android:backgroundDimAmount">0.4</item>
+    </style>
+
+</resources>
