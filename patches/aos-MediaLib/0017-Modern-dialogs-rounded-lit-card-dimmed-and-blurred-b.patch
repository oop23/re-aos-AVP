From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: oop23 <ilidans01yt@gmail.com>
Date: Sat, 10 Oct 2026 05:00:50 +0000
Subject: [PATCH] Modern dialogs: rounded lit card, dimmed and blurred backdrop

Every dialog family (AppCompat, MaterialAlertDialogBuilder, framework)
gets the ReNova palette with Material 3 surface container roles, a 28dp
rounded card lit from the top with a thin light edge, and on Android 12+
the screen behind is blurred instead of only dimmed. The black theme
moves to Material 3 too.
---
 res/drawable/renova_dialog_background.xml     |  19 +++
 .../renova_dialog_background_black.xml        |  18 +++
 res/values-v31/colors.xml                     |   8 ++
 res/values-v31/themes.xml                     |  40 +++++++
 res/values/colors.xml                         |   6 +
 res/values/dimens.xml                         |   1 +
 res/values/themes.xml                         | 110 +++++++++++++++++-
 7 files changed, 198 insertions(+), 4 deletions(-)
 create mode 100644 res/drawable/renova_dialog_background.xml
 create mode 100644 res/drawable/renova_dialog_background_black.xml
 create mode 100644 res/values-v31/colors.xml
 create mode 100644 res/values-v31/themes.xml

diff --git a/res/drawable/renova_dialog_background.xml b/res/drawable/renova_dialog_background.xml
new file mode 100644
index 0000000..1135941
--- /dev/null
+++ b/res/drawable/renova_dialog_background.xml
@@ -0,0 +1,19 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- ReNova dialogs: rounded, softly lit from the top, thin light edge (see Theme.AlertDialog) -->
+<inset xmlns:android="http://schemas.android.com/apk/res/android"
+    android:insetLeft="20dp"
+    android:insetTop="24dp"
+    android:insetRight="20dp"
+    android:insetBottom="24dp">
+    <shape android:shape="rectangle">
+        <corners android:radius="28dp" />
+        <gradient
+            android:angle="270"
+            android:startColor="@color/renova_dialog_top"
+            android:endColor="@color/renova_dialog_bottom"
+            android:type="linear" />
+        <stroke
+            android:width="1dp"
+            android:color="@color/renova_dialog_edge" />
+    </shape>
+</inset>
