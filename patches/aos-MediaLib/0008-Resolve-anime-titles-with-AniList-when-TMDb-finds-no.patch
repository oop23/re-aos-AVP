+package com.archos.mediascraper.anilist;
+
+import android.util.LruCache;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Set;
+import java.util.concurrent.TimeUnit;
+
+import okhttp3.MediaType;
+import okhttp3.OkHttpClient;
+import okhttp3.Request;
+import okhttp3.RequestBody;
+import okhttp3.Response;
+
+/**
+ * Minimal client of the official AniList GraphQL API (https://docs.anilist.co, no key needed).
+ *
+ * Anime files are usually named with the romaji title used by fansubs and streaming dumps
+ * ("Sousou no Frieren", "Shingeki no Kyojin") which TMDb often does not index, so the episode ended
+ * up unscraped or matched to a random movie. AniList resolves such names to the english / romaji /
+ * native titles, which are then searched on TMDb.
+ */
+public final class AniListClient {
+
+    private static final Logger log = LoggerFactory.getLogger(AniListClient.class);
+
+    private static final String ENDPOINT = "https://graphql.anilist.co";
+    private static final MediaType JSON = MediaType.get("application/json; charset=utf-8");
+    private static final String QUERY =
+            "query ($search: String) { Page(perPage: 3) { media(search: $search, type: ANIME, sort: SEARCH_MATCH) {"
+                    + " id idMal title { romaji english native } synonyms seasonYear format } } }";
+
+    private static final LruCache<String, List<String>> sCache = new LruCache<>(200);
+    private static volatile OkHttpClient sClient;
+
+    private AniListClient() {}
+
+    private static OkHttpClient client() {
+        if (sClient == null) {
+            synchronized (AniListClient.class) {
+                if (sClient == null) {
+                    sClient = new OkHttpClient.Builder()
+                            .connectTimeout(8, TimeUnit.SECONDS)
+                            .readTimeout(8, TimeUnit.SECONDS)
+                            .callTimeout(12, TimeUnit.SECONDS)
+                            .build();
+                }
+            }
+        }
+        return sClient;
+    }
+
+    /**
+     * Titles the best AniList match of {@code query} is known under (english first, then romaji,
+     * then latin synonyms). Empty when nothing matched or AniList is unreachable. Blocking: call it
+     * from a scraper thread.
+     */
+    public static List<String> alternateTitles(String query) {
+        if (query == null || query.trim().length() < 2) return Collections.emptyList();
+        String key = query.trim().toLowerCase(Locale.ROOT);
+        List<String> cached = sCache.get(key);
+        if (cached != null) return cached;
+        List<String> titles = Collections.emptyList();
+        try {
+            JSONObject body = new JSONObject()
+                    .put("query", QUERY)
+                    .put("variables", new JSONObject().put("search", query.trim()));
+            Request request = new Request.Builder()
+                    .url(ENDPOINT)
+                    .header("Accept", "application/json")
+                    .post(RequestBody.create(body.toString(), JSON))
+                    .build();
+            try (Response response = client().newCall(request).execute()) {
+                if (response.isSuccessful() && response.body() != null) {
+                    titles = parseTitles(response.body().string());
+                } else {
+                    log.warn("alternateTitles: AniList answered {} for {}", response.code(), query);
+                    return titles; // do not cache transient failures (rate limit, outage)
+                }
+            }
+        } catch (Exception e) {
+            log.warn("alternateTitles: AniList unreachable for {}: {}", query, e.toString());
+            return titles;
+        }
+        if (log.isDebugEnabled()) log.debug("alternateTitles: {} -> {}", query, titles);
+        sCache.put(key, titles);
+        return titles;
+    }
+
+    /** Parses an AniList answer into the titles of its best match. Package visible for tests. */
+    static List<String> parseTitles(String json) throws JSONException {
+        JSONObject root = new JSONObject(json);
+        JSONObject data = root.optJSONObject("data");
+        JSONObject page = data == null ? null : data.optJSONObject("Page");
+        JSONArray media = page == null ? null : page.optJSONArray("media");
+        if (media == null || media.length() == 0) return Collections.emptyList();
+        JSONObject best = media.getJSONObject(0);
+        Set<String> titles = new LinkedHashSet<>();
+        JSONObject title = best.optJSONObject("title");
+        if (title != null) {
+            add(titles, title.optString("english", null));
+            add(titles, title.optString("romaji", null));
+        }
+        JSONArray synonyms = best.optJSONArray("synonyms");
+        if (synonyms != null) {
+            for (int i = 0; i < synonyms.length() && titles.size() < 5; i++) {
+                String s = synonyms.optString(i, null);
+                if (isLatin(s)) add(titles, s);
+            }
+        }
+        if (title != null) add(titles, title.optString("native", null));
+        return Collections.unmodifiableList(new ArrayList<>(titles));
+    }
+
+    private static void add(Set<String> titles, String t) {
+        if (t != null && !t.trim().isEmpty() && !"null".equals(t)) titles.add(t.trim());
+    }
+
+    private static boolean isLatin(String s) {
+        if (s == null) return false;
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            if (Character.isLetter(c) && !isLatinLetter(c)) return false;
+        }
+        return true;
+    }
+
+    // Character.UnicodeScript needs API 24, minSdk is 23
+    static boolean isLatinLetter(int cp) {
+        return cp < 0x250 || (cp >= 0x1E00 && cp <= 0x1EFF) || (cp >= 0x2C60 && cp <= 0x2C7F)
+                || (cp >= 0xA720 && cp <= 0xA7FF) || (cp >= 0xFF21 && cp <= 0xFF5A);
+    }
+}
diff --git a/src/com/archos/mediascraper/themoviedb3/SearchShow.java b/src/com/archos/mediascraper/themoviedb3/SearchShow.java
index 7205777..dfbe7a6 100644
--- a/src/com/archos/mediascraper/themoviedb3/SearchShow.java
+++ b/src/com/archos/mediascraper/themoviedb3/SearchShow.java
@@ -16,6 +16,7 @@ package com.archos.mediascraper.themoviedb3;
 
 import android.util.LruCache;
 
+import com.archos.mediascraper.anilist.AniListClient;
 import com.archos.mediascraper.ScrapeStatus;
 import com.archos.mediascraper.SearchResult;
 import com.archos.mediascraper.ShowUtils;
@@ -124,6 +125,21 @@ public class SearchShow {
                             }
                         }
                     }
+                    if (response.body() == null || response.body().total_results == 0) {
+                        // anime: romaji / fansub names TMDb does not index ("Sousou no Frieren"),
+                        // AniList knows the english / romaji / native titles TMDb uses
+                        for (String alternateTitle : AniListClient.alternateTitles(searchQueryString)) {
+                            if (alternateTitle.equalsIgnoreCase(searchQueryString)) continue;
+                            if (log.isDebugEnabled()) log.debug("search: no results, retrying with AniList title: {}", alternateTitle);
+                            response = tmdb.searchService().tv(alternateTitle, 1, language, year, false).execute();
+                            if (response.isSuccessful()) isResponseOk = true;
+                            if (response.body() != null && response.body().total_results == 0 && !language.equals("en")) {
+                                response = tmdb.searchService().tv(alternateTitle, 1, "en", year, false).execute();
+                                if (response.isSuccessful()) isResponseOk = true;
+                            }
+                            if (response.body() != null && response.body().total_results > 0) break;
+                        }
+                    }
                     if (response.body() == null || response.body().total_results == 0) notFoundIssue = true;
                     else notFoundIssue = false;
 
