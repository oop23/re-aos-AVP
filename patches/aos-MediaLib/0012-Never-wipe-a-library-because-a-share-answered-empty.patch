+package com.archos.mediaprovider.video;
+
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import android.content.Context;
+
+import androidx.test.core.app.ApplicationProvider;
+
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.annotation.Config;
+
+@RunWith(RobolectricTestRunner.class)
+@Config(sdk = 33)
+public class MassDeletionGuardTest {
+
+    private Context mContext;
+
+    @Before
+    public void setUp() {
+        mContext = ApplicationProvider.getApplicationContext();
+        mContext.getSharedPreferences("mass_deletion_guard", Context.MODE_PRIVATE).edit().clear().commit();
+    }
+
+    @Test
+    public void smallOrPartialRemovalsAreApplied() {
+        assertFalse(MassDeletionGuard.isMassDeletion(1000, 10));
+        assertFalse(MassDeletionGuard.isMassDeletion(1000, 400));
+        assertFalse(MassDeletionGuard.isMassDeletion(30, 19));
+        assertFalse(MassDeletionGuard.shouldDefer(mContext, "smb://nas/movies", 1000, 400));
+    }
+
+    @Test
+    public void emptyListingOfABigLibraryIsDeferredOnce() {
+        assertTrue(MassDeletionGuard.isMassDeletion(1000, 1000));
+        // first scan sees an empty share: keep the library
+        assertTrue(MassDeletionGuard.shouldDefer(mContext, "smb://nas/movies", 1000, 1000));
+        // second scan confirms: apply
+        assertFalse(MassDeletionGuard.shouldDefer(mContext, "smb://nas/movies", 1000, 1000));
+        // and the state is reset afterwards
+        assertTrue(MassDeletionGuard.shouldDefer(mContext, "smb://nas/movies", 1000, 1000));
+    }
+
+    @Test
+    public void aHealthyScanInBetweenResetsTheGuard() {
+        assertTrue(MassDeletionGuard.shouldDefer(mContext, "smb://nas/series", 500, 500));
+        assertFalse(MassDeletionGuard.shouldDefer(mContext, "smb://nas/series", 500, 0));
+        assertTrue(MassDeletionGuard.shouldDefer(mContext, "smb://nas/series", 500, 500));
+    }
+}
