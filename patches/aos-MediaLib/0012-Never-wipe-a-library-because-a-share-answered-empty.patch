 .../video/NetworkScannerServiceVideo.java     | 11 ++++
 .../video/MassDeletionGuardTest.java          | 65 +++++++++++++++++++
 3 files changed, 130 insertions(+)
 create mode 100644 src/com/archos/mediaprovider/video/MassDeletionGuard.java
 create mode 100644 test/java/com/archos/mediaprovider/video/MassDeletionGuardTest.java

