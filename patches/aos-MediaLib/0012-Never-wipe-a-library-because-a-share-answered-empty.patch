             }
 
+            if (totalNeedsDelete > 0) {
+                String guardRoot = (root != null) ? root.getUri().toString() : (mService != null ? mService.mCurrentRootUri : null);
+                if (MassDeletionGuard.shouldDefer(mService, guardRoot, mPrescanItemsMap.size(), totalNeedsDelete)) {
+                    // ReNova: most of the library under this root would go: likely an unreachable or
+                    // half mounted share, wait for the next scan to confirm before removing anything
+                    log.warn("onStop: deferring removal of {}/{} items under {} until confirmed by the next scan",
+                            totalNeedsDelete, mPrescanItemsMap.size(), guardRoot);
+                    totalNeedsDelete = 0;
+                }
+            }
+
             if (totalNeedsDelete > 0) {
                 String path = (root != null) ? root.getUri().toString() : (mService != null ? mService.mCurrentRootUri : null);
                 int remaining = totalNeedsDelete;
