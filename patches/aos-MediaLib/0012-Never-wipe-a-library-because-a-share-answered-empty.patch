+package com.archos.mediaprovider.video;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+/**
+ * Libraries must not vanish because a NAS was still asleep, a volume was mounted empty or a share
+ * answered with a partial listing (see upstream #1403, #844). When a network rescan would remove
+ * most of what is known under a root, the removal is deferred: it only happens if the next scan
+ * sees the same thing again. Real, user-made removals are therefore applied one scan later.
+ */
+public final class MassDeletionGuard {
+
+    private static final String PREFS = "mass_deletion_guard";
+    static final int MIN_ITEMS = 20;
+
+    private MassDeletionGuard() {}
+
+    /** pure decision, package visible for tests */
+    static boolean isMassDeletion(int knownItems, int itemsToDelete) {
+        return itemsToDelete >= MIN_ITEMS && itemsToDelete * 2 > knownItems;
+    }
+
+    /**
+     * @return true when the deletions must be skipped for this scan
+     */
+    public static boolean shouldDefer(Context context, String root, int knownItems, int itemsToDelete) {
+        if (context == null || root == null) return false;
+        SharedPreferences prefs = context.getApplicationContext().getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+        if (!isMassDeletion(knownItems, itemsToDelete)) {
+            if (prefs.contains(root)) prefs.edit().remove(root).apply();
+            return false;
+        }
+        if (prefs.contains(root)) {
+            // confirmed by a second scan: the files are really gone
+            prefs.edit().remove(root).apply();
+            return false;
+        }
+        prefs.edit().putInt(root, itemsToDelete).apply();
+        return true;
+    }
+}
