diff --git a/src/com/archos/mediascraper/ShowTags.java b/src/com/archos/mediascraper/ShowTags.java
index 1bb2c98..2c41d3d 100644
--- a/src/com/archos/mediascraper/ShowTags.java
+++ b/src/com/archos/mediascraper/ShowTags.java
@@ -171,6 +171,8 @@ public class ShowTags extends VideoTags {
 
     @Override
     public long save(Context context, long videoId) {
+        // what the user edited wins over scraped data
+        MetadataOverrides.applyTo(context, this);
 
         // prepare cover / backdrop info
         ScraperImage cover = getDefaultPoster();
