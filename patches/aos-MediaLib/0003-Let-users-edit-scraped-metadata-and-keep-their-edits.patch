 .../mediascraper/MetadataOverrides.java       | 202 ++++++++++++++++++
 src/com/archos/mediascraper/MovieTags.java    |   2 +
 src/com/archos/mediascraper/ShowTags.java     |   2 +
 4 files changed, 208 insertions(+)
 create mode 100644 src/com/archos/mediascraper/MetadataOverrides.java

diff --git a/src/com/archos/mediascraper/EpisodeTags.java b/src/com/archos/mediascraper/EpisodeTags.java
