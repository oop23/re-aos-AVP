@@ -124,6 +124,8 @@ public class EpisodeTags extends BaseTags {
     public long save(Context context, long videoId) {
         // save the video id in this tag
         setVideoId(videoId);
+        // what the user edited wins over scraped data
+        MetadataOverrides.applyTo(context, this, videoId);
 
         ContentResolver cr = context.getContentResolver();
 
diff --git a/src/com/archos/mediascraper/MetadataOverrides.java b/src/com/archos/mediascraper/MetadataOverrides.java
new file mode 100644
index 0000000..0f7ee2c
--- /dev/null
+++ b/src/com/archos/mediascraper/MetadataOverrides.java
@@ -0,0 +1,202 @@
