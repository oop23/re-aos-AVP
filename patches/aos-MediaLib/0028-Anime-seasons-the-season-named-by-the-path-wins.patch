From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: oop23 <ilidans01yt@gmail.com>
Date: Sat, 10 Oct 2026 05:46:00 +0000
Subject: [PATCH] Anime seasons: the season named by the path wins

'KonoSuba 2', 'Shingeki no Kyojin Season 3' or a 'Sezon 1' folder name
the season; absolute episode numbers ('One Piece - 1050') are only
mapped to TMDb seasons when nothing named it, so an OVA numbered 11 in
KonoSuba season 1 no longer lands in season 2. Dash numbered episodes
inside an Anime folder are recognized without a fansub tag.
---
 src/com/archos/mediascraper/ShowUtils.java    |  2 +
 .../preprocess/FolderEpisodeMatcher.java      |  2 +-
 .../preprocess/FolderEpisodeNaming.java       | 55 +++++++++++++++++--
 .../preprocess/TvShowSearchInfo.java          | 12 ++++
 .../themoviedb3/SearchShowParser.java         |  1 +
 .../archos/mediascraper/xml/ShowScraper4.java |  7 ++-
 .../preprocess/FolderEpisodeNamingTest.java   | 20 +++++++
 7 files changed, 91 insertions(+), 8 deletions(-)

diff --git a/src/com/archos/mediascraper/ShowUtils.java b/src/com/archos/mediascraper/ShowUtils.java
index b2e1023..31402d1 100644
--- a/src/com/archos/mediascraper/ShowUtils.java
+++ b/src/com/archos/mediascraper/ShowUtils.java
@@ -51,6 +51,8 @@ public final class ShowUtils {
 
     public static final String EPNUM = "epnum";
     public static final String SEASON = "season";
+    /** ReNova: "1" when the season was not named by the path (absolute episode numbers allowed) */
+    public static final String SEASON_GUESSED = "season_guessed";
     public static final String SHOW = "show";
     public static final String YEAR = "year";
     public static final String ORIGIN = "origin";
diff --git a/src/com/archos/mediascraper/preprocess/FolderEpisodeMatcher.java b/src/com/archos/mediascraper/preprocess/FolderEpisodeMatcher.java
index a8ed50a..99e28ff 100644
--- a/src/com/archos/mediascraper/preprocess/FolderEpisodeMatcher.java
+++ b/src/com/archos/mediascraper/preprocess/FolderEpisodeMatcher.java
@@ -55,7 +55,7 @@ class FolderEpisodeMatcher implements InputMatcher {
         FolderEpisodeNaming.Result r = FolderEpisodeNaming.parse(file.getPathSegments());
         if (r == null) return null;
         if (log.isDebugEnabled()) log.debug("getFileInputMatch: {} -> {}", file, r);
-        return new TvShowSearchInfo(file, r.title, r.season, r.episode, r.year, null);
+        return new TvShowSearchInfo(file, r.title, r.season, r.episode, r.year, null).setSeasonGuessed(!r.seasonKnown);
     }
 
     @Override
diff --git a/src/com/archos/mediascraper/preprocess/FolderEpisodeNaming.java b/src/com/archos/mediascraper/preprocess/FolderEpisodeNaming.java
index 881adea..09bed90 100644
--- a/src/com/archos/mediascraper/preprocess/FolderEpisodeNaming.java
+++ b/src/com/archos/mediascraper/preprocess/FolderEpisodeNaming.java
@@ -38,12 +38,15 @@ public final class FolderEpisodeNaming {
         public final int season;
         public final int episode;
         public final String year;
+        /** false when the season is the default 1, nothing in the path named it */
+        public final boolean seasonKnown;
 
-        Result(String title, int season, int episode, String year) {
+        Result(String title, int season, int episode, String year, boolean seasonKnown) {
             this.title = title;
             this.season = season;
             this.episode = episode;
             this.year = year;
+            this.seasonKnown = seasonKnown;
         }
 
         @Override
@@ -134,7 +137,8 @@ public final class FolderEpisodeNaming {
         if ((m = DASH_NUMBER.matcher(withoutGroup)).matches()) {
             String number = m.group(2);
             boolean plausible = groupTagged || number.startsWith("0")
-                    || BRACKETS.matcher(withoutGroup.substring(m.end(2))).find();
+                    || BRACKETS.matcher(withoutGroup.substring(m.end(2))).find()
+                    || inAnimeFolder(pathSegments);
             if (plausible && !number.matches("(?:19|20)\\d{2}")) {
                 return fromTitle(m.group(1), pathSegments, toInt(number));
             }
@@ -171,10 +175,35 @@ public final class FolderEpisodeNaming {
         if (title.isEmpty()) return null;
         int season = seasonIn(rawTitle);
         if (season > 0) title = cleanTitle(removeSeason(rawTitle));
-        if (season < 0) season = seasonFromFolders(segments);
         String year = yearIn(rawTitle);
         if (year != null) title = cleanTitle(removeYear(title));
-        return title.isEmpty() ? null : new Result(title, season > 0 ? season : 1, episode, year);
+        if (season < 0) {
+            // "KonoSuba 2 - 05": a trailing digit names the season of anime titles
+            int trailing = trailingSeason(title);
+            if (trailing > 0) {
+                season = trailing;
+                title = removeTrailingNumber(title);
+            }
+        }
+        if (season < 0) season = seasonFromFolders(segments);
+        return title.isEmpty() ? null : new Result(title, season > 0 ? season : 1, episode, year, season > 0);
+    }
+
+    // "Kaiju No. 8", "Part 2", "Vol 3": the number belongs to the title, not a season
+    private static final Pattern NOT_A_SEASON_BEFORE = Pattern.compile(
+            "(?i).*\\b(?:no|nr|number|part|pt|cour|vol|volume|chapter|ep|episode|odc|odcinek)\\.?$|.*#$");
+    private static final Pattern TRAILING_DIGIT = Pattern.compile("^(.*\\S)\\s+([2-9])$");
+
+    /** 2..9 when the (clean) title ends with a lone digit naming a season, else -1 */
+    static int trailingSeason(String title) {
+        Matcher m = TRAILING_DIGIT.matcher(title);
+        if (!m.matches() || NOT_A_SEASON_BEFORE.matcher(m.group(1)).matches()) return -1;
+        return toInt(m.group(2));
+    }
+
+    private static String removeTrailingNumber(String title) {
+        Matcher m = TRAILING_DIGIT.matcher(title);
+        return m.matches() ? cleanTitle(m.group(1)) : title;
     }
 
     private static Result fromFolders(List<String> segments, int season, int episode) {
@@ -193,8 +222,15 @@ public final class FolderEpisodeNaming {
             if (season < 0 && folderSeason > 0) season = folderSeason;
             String year = yearIn(raw);
             if (year != null) title = cleanTitle(removeYear(title));
+            if (folderSeason < 0) {
+                int trailing = trailingSeason(title);
+                if (trailing > 0) {
+                    title = removeTrailingNumber(title);
+                    if (season < 0) season = trailing;
+                }
+            }
             if (title.isEmpty() || GENERIC_FOLDERS.contains(title.toLowerCase(Locale.ROOT))) return null;
-            return new Result(title, season > 0 ? season : 1, episode, year);
+            return new Result(title, season > 0 ? season : 1, episode, year, season > 0);
         }
         return null;
     }
@@ -204,6 +240,15 @@ public final class FolderEpisodeNaming {
             Matcher sf = SEASON_FOLDER.matcher(normalize(segments.get(i)));
             if (sf.matches()) return toInt(sf.group(1));
         }
+        // the show folder itself: "Shingeki no Kyojin Season 3", "KonoSuba 2"
+        if (segments.size() >= 2) {
+            String parent = normalize(segments.get(segments.size() - 2)).replaceFirst("^(?:\\[[^\\]]*\\]\\s*)+", "");
+            if (!GENERIC_FOLDERS.contains(cleanTitle(parent).toLowerCase(Locale.ROOT))) {
+                int season = seasonIn(parent);
+                if (season > 0) return season;
+                return trailingSeason(cleanTitle(removeYear(parent)));
+            }
+        }
         return -1;
     }
 
