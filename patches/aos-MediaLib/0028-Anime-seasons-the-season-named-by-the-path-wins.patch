diff --git a/src/com/archos/mediascraper/xml/ShowScraper4.java b/src/com/archos/mediascraper/xml/ShowScraper4.java
index 58d6eec..27e58b7 100644
--- a/src/com/archos/mediascraper/xml/ShowScraper4.java
+++ b/src/com/archos/mediascraper/xml/ShowScraper4.java
@@ -363,8 +363,11 @@ public class ShowScraper4 extends BaseScraper2 {
 
         // ReNova: anime dumps number episodes from the start of the show ("One Piece - 1050" is
         // read as S1E1050) while TMDb splits it into seasons: map the absolute number to TMDb's
-        // season/episode from the episode counts of its seasons (show info is cached per show)
-        if (requestedSeason == 1 && requestedEpisode > 10 && season <= 1) {
