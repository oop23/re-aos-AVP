             String absShowKey = ShowUtils.cleanUpName(result.getOriginalTitle().toLowerCase()) + "|" + showId + "|" + resultLanguage;
             ShowIdTvSearchResult showInfo = ShowIdTvSearch.getTvShowResponse(absShowKey + requestCacheSuffix, showId, resultLanguage, adultScrape, requestTmdb);
             if (showInfo != null && showInfo.status == ScrapeStatus.OKAY && showInfo.tvShow != null && showInfo.tvShow.seasons != null) {
diff --git a/test/java/com/archos/mediascraper/preprocess/FolderEpisodeNamingTest.java b/test/java/com/archos/mediascraper/preprocess/FolderEpisodeNamingTest.java
index 3101e82..ec5b8c4 100644
--- a/test/java/com/archos/mediascraper/preprocess/FolderEpisodeNamingTest.java
+++ b/test/java/com/archos/mediascraper/preprocess/FolderEpisodeNamingTest.java
@@ -13,6 +13,7 @@
 package com.archos.mediascraper.preprocess;
 
 import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
 import static org.junit.Assert.assertNull;
 import static org.junit.Assert.assertTrue;
 
@@ -58,6 +59,25 @@ public class FolderEpisodeNamingTest {
         assertEquals("Naruto S1E1", parse("/Anime/Naruto/Naruto 001.mp4"));
     }
 
+    @Test
+    public void seasonFromTrailingNumberAndFolders() {
+        // KonoSuba season 1 used to land in season 2 (an episode past the first season was read
+        // as an absolute number); the season named by the path always wins
+        assertEquals("Kono Subarashii Sekai ni Shukufuku wo! S2E5",
+                parse("/Anime/Kono Subarashii Sekai ni Shukufuku wo! 2/Kono Subarashii Sekai ni Shukufuku wo! 2 - 05.mkv"));
+        assertEquals("KonoSuba S2E5", parse("/Anime/KonoSuba 2/05.mkv"));
+        assertEquals("KonoSuba S2E5", parse("/Anime/KonoSuba 2/[SubsPlease] KonoSuba - 05.mkv"));
+        assertEquals("KonoSuba S1E11", parse("/Anime/KonoSuba/Sezon 1/Odcinek 11.mp4"));
+        assertEquals("Kaiju No. 8 S1E5", parse("/Anime/Kaiju No. 8/Kaiju No. 8 - 05.mkv"));
+        assertEquals("One Piece S1E1050", parse("/Anime/One Piece/One Piece - 1050.mp4"));
+    }
+
+    @Test
+    public void seasonKnownOnlyWhenThePathNamesIt() {
+        assertTrue(FolderEpisodeNaming.parse(Arrays.asList("Anime", "KonoSuba", "Sezon 1", "Odcinek 11.mp4")).seasonKnown);
+        assertFalse(FolderEpisodeNaming.parse(Arrays.asList("Anime", "One Piece", "One Piece - 1050.mp4")).seasonKnown);
+    }
+
     @Test
     public void moviePartsAndNumberedTitlesStayMovies() {
         assertEquals("null", parse("/Filmy/Kill Bill Vol 01.mkv"));
